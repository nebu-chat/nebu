<h1 class="text-heading font-semibold mb-4">Configuration</h1>
<p class="text-text-secondary mb-4">
  Instance settings (<code>server_config</code>). Edit OIDC claim and role mapping via
  their dedicated pages.
</p>

<p :if={Phoenix.Flash.get(@flash, :info)} class="alert alert-success mb-4" role="status">
  {Phoenix.Flash.get(@flash, :info)}
</p>
<p :if={Phoenix.Flash.get(@flash, :error)} class="alert alert-error mb-4" role="alert">
  {Phoenix.Flash.get(@flash, :error)}
</p>

<%!-- OIDC scopes: POST form (story configurable-oidc-scopes, AC7/AC8).
      Operators change scope strings at runtime — no redeploy needed.
      openid is always included by scope_list/0 and admin_oidc_scope/0. --%>
<form id="oidc-scopes-form" method="post" action="/admin/config/scopes" class="mb-6">
  <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
  <h2 class="text-heading font-semibold mb-2">OIDC scopes</h2>

  <label class="form-control mt-2">
    <span class="label-text">Matrix client scopes</span>
    <input
      type="text"
      name="matrix_oidc_extra_scopes"
      aria-label="Matrix client scopes"
      value={scope_value(@config, "matrix_oidc_extra_scopes")}
      placeholder="profile email"
      class="input input-bordered"
    />
    <span class="label-text-alt mt-1 text-base-content/70">
      Space-separated scope names. <code>openid</code> is always included.
    </span>
  </label>

  <label class="form-control mt-2">
    <span class="label-text">Admin client scopes</span>
    <input
      type="text"
      name="admin_oidc_extra_scopes"
      aria-label="Admin client scopes"
      value={scope_value(@config, "admin_oidc_extra_scopes")}
      placeholder="profile email groups"
      class="input input-bordered"
    />
    <span class="label-text-alt mt-1 text-base-content/70">
      Space-separated scope names. <code>openid</code> is always included.
    </span>
  </label>

  <button type="submit" class="btn btn-primary mt-3">Save scopes</button>
</form>

<%!-- SSO redirect schemes: POST form (story fix-and-configure-sso-redirect-schemes,
      AC8/AC9). Additional client deep-link schemes allowed as redirectUrl on
      GET /_matrix/client/v3/login/sso/redirect, beyond the hardcoded defaults
      (element, schildichat, im.fluffychat.auth). No redeploy needed. --%>
<form id="sso-schemes-form" method="post" action="/admin/config/sso-schemes" class="mb-6">
  <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
  <h2 class="text-heading font-semibold mb-2">SSO redirect schemes</h2>

  <label class="form-control mt-2">
    <span class="label-text">Additional SSO redirect schemes</span>
    <input
      type="text"
      name="sso_extra_redirect_schemes"
      aria-label="Additional SSO redirect schemes"
      value={sso_schemes_value(@config, "sso_extra_redirect_schemes")}
      placeholder="myorg-matrix, custom-app"
      class="input input-bordered"
    />
    <span class="label-text-alt mt-1 text-base-content/70">
      Comma-separated scheme names (case-insensitive, alphanumeric + dash/dot/plus only).
      Examples: element, schildichat, im.fluffychat.auth, myorg-matrix. Hardcoded denylist
      (javascript, data, file, vbscript, blob) cannot be overridden.
    </span>
  </label>

  <button type="submit" class="btn btn-primary mt-3">Save SSO schemes</button>
</form>

<%!-- OIDC refresh mode: POST form. Two native <select>s (Matrix + admin),
      mirroring the bootstrap wizard contract (story oidc-refresh-mode-config,
      AC5/AC6). Operators change either client's mode at runtime — no redeploy. --%>
<form id="oidc-refresh-mode-form" method="post" action="/admin/config/refresh-mode" class="mb-6">
  <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
  <h2 class="text-heading font-semibold mb-2">OIDC refresh mode</h2>

  <label class="form-control mt-2">
    <span class="label-text">Matrix client refresh mode</span>
    <select name="matrix_oidc_refresh_mode" aria-label="Matrix refresh mode" class="select select-bordered">
      <option value="offline" selected={refresh_mode(@config, "matrix_oidc_refresh_mode") == "offline"}>
        offline (offline_access)
      </option>
      <option value="online" selected={refresh_mode(@config, "matrix_oidc_refresh_mode") == "online"}>
        online
      </option>
    </select>
  </label>

  <label class="form-control mt-2">
    <span class="label-text">Admin client refresh mode</span>
    <select name="admin_oidc_refresh_mode" aria-label="Admin refresh mode" class="select select-bordered">
      <option value="offline" selected={refresh_mode(@config, "admin_oidc_refresh_mode") == "offline"}>
        offline (offline_access)
      </option>
      <option value="online" selected={refresh_mode(@config, "admin_oidc_refresh_mode") == "online"}>
        online
      </option>
    </select>
  </label>

  <p class="text-sm text-text-secondary mt-2">
    <strong>offline</strong>: long-lived offline refresh token (survives IdP logout).
    <strong>online</strong>: session-bound refresh token (dies on IdP SSO logout).
    <strong>Dex issues a refresh token only when <code>offline_access</code> is requested</strong>
    — so in online mode refresh is disabled on Dex (use offline for Dex).
  </p>

  <button type="submit" class="btn btn-primary mt-3">Save refresh mode</button>
</form>

<div class="overflow-x-auto">
  <table class="table table-zebra">
    <thead>
      <tr><th>Key</th><th>Value</th></tr>
    </thead>
    <tbody>
      <tr :for={{k, v} <- @config}>
        <td class="font-mono text-mono">{k}</td>
        <td class="font-mono text-mono break-all">{v}</td>
      </tr>
    </tbody>
  </table>
</div>
