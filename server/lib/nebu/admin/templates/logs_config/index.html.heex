<h1 class="text-heading font-semibold mb-4">Logs Configuration</h1>
<p class="text-text-secondary mb-4">
  Configure which log levels are collected to the database and how long they are retained.
  The warn and error levels are always collected and cannot be disabled here; the info and
  debug levels can be toggled on/off with a custom retention window (days and/or max entry
  count).
</p>

<p :if={Phoenix.Flash.get(@flash, :info)} class="alert alert-success mb-4" role="status">
  {Phoenix.Flash.get(@flash, :info)}
</p>
<p :if={Phoenix.Flash.get(@flash, :error)} class="alert alert-error mb-4" role="alert">
  {Phoenix.Flash.get(@flash, :error)}
</p>

<form
  id="logs-retention-form"
  data-testid="logs-retention-form"
  method="post"
  action="/admin/logs/config/retention"
  class="mb-6"
>
  <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

  <h2 class="text-heading font-semibold mb-2">Collection levels</h2>

  <div class="flex flex-wrap gap-4 mb-4">
    <%!-- WARN — always-on, non-interactive (AC6). Hand-rolled (not the
          reused TraceMapBubble component, which always renders a real
          <button>) so it can be a plain, non-interactive <div>. --%>
    <div
      data-testid="trace-map-bubble"
      data-bubble-dimension="level"
      data-bubble-value="warning"
      data-bubble-count="0"
      aria-disabled="true"
      title="Warning is always collected"
      class="btn btn-sm btn-disabled gap-1 normal-case opacity-80"
    ><span>🟠 WARNING</span><span class="text-xs">✓ immer</span></div>

    <%!-- ERROR — always-on, non-interactive (AC6). --%>
    <div
      data-testid="trace-map-bubble"
      data-bubble-dimension="level"
      data-bubble-value="error"
      data-bubble-count="0"
      aria-disabled="true"
      title="Error is always collected"
      class="btn btn-sm btn-disabled gap-1 normal-case opacity-80"
    ><span>🔴 ERROR</span><span class="text-xs">✓ immer</span></div>

    <%!-- INFO — interactive toggle (AC7). Same visual language (icon +
          color-coded bubble shape) as the reused TraceMapBubble component
          from the monitoring page's :configure mode, but hand-rolled here
          rather than calling that component directly: this page has no
          LiveView socket, so the component's phx-click would be inert
          anyway, and hand-rolling keeps full control over attribute
          ordering/markup size for this page's own contract. Real
          interaction is wired client-side by app.js's
          wireLogsConfigToggles(). --%>
    <button
      type="button"
      data-testid="trace-map-bubble"
      data-bubble-dimension="level"
      data-bubble-value="info"
      aria-pressed={to_string(@state.info_enabled)}
      aria-expanded={to_string(@state.info_enabled)}
      aria-controls="info-retention-fields"
      aria-label="Configure retention for level info"
      class={["btn btn-sm gap-1 normal-case", @state.info_enabled && "btn-active"]}
    ><span>🟢 INFO</span></button>

    <%!-- DEBUG — interactive toggle (AC7). --%>
    <button
      type="button"
      data-testid="trace-map-bubble"
      data-bubble-dimension="level"
      data-bubble-value="debug"
      aria-pressed={to_string(@state.debug_enabled)}
      aria-expanded={to_string(@state.debug_enabled)}
      aria-controls="debug-retention-fields debug-warning"
      aria-label="Configure retention for level debug"
      class={["btn btn-sm gap-1 normal-case", @state.debug_enabled && "btn-active"]}
    ><span>⚪ DEBUG</span></button>
  </div>

  <%!-- Hidden inputs carry the REAL submitted enabled-state for INFO/DEBUG —
        toggled by app.js on bubble click, since the reused button's own
        phx-click never fires (no LiveView socket here). --%>
  <input
    type="hidden"
    name="info_enabled"
    value={to_string(@state.info_enabled)}
    data-testid="info-enabled-input"
  />
  <input
    type="hidden"
    name="debug_enabled"
    value={to_string(@state.debug_enabled)}
    data-testid="debug-enabled-input"
  />

  <%!-- Inline retention fields (AC9): server-conditionally rendered
        (:if={@state.info_enabled}) — ABSENT from the DOM entirely while the
        level is off (not merely CSS-hidden), matching AC16's "no retention
        fields visible for a disabled level" contract. app.js dynamically
        creates/removes an equivalent node client-side when the operator
        toggles a level without a page reload (AC7/AC8).

        UX-gate fix (blocking): the toggle button only carries
        `aria-pressed`, so a screen-reader user heard the pressed-state
        change but got no signal that new required fields just appeared.
        Each level's controlled region is now wrapped in a STABLE
        `aria-live="polite"` container (always present, unlike its `:if`-ed
        child) — mirrors the existing `aria-live="polite"` pattern already
        used for dynamically-appearing content on the sibling monitoring
        page (`logs_live.ex`'s `[data-testid="new-entries-banner"]`).
        `aria-expanded`/`aria-controls` on the toggle button (added above)
        provide a second, redundant discoverability signal. --%>
  <div id="info-retention-live" aria-live="polite" aria-atomic="true">
    <div :if={@state.info_enabled} id="info-retention-fields" data-testid="retention-fields" data-bubble-value="info" class="mb-4 flex flex-wrap gap-4 items-end">
      <label class="form-control">
        <span class="label-text">Retention: days</span>
        <input
          type="number"
          name="info_days"
          value={@state.info_days}
          placeholder="Leave blank for no limit"
          aria-label="INFO retention days"
          min="0"
          max="90"
          class="input input-bordered input-sm"
        />
      </label>
      <label class="form-control">
        <span class="label-text">Retention: max entries</span>
        <input
          type="number"
          name="info_max_entries"
          value={@state.info_max_entries}
          placeholder="Leave blank for no limit"
          aria-label="INFO retention max entries"
          min="0"
          max="10000"
          class="input input-bordered input-sm"
        />
      </label>
    </div>
  </div>

  <div id="debug-retention-live" aria-live="polite" aria-atomic="true">
    <div :if={@state.debug_enabled} id="debug-retention-fields" data-testid="retention-fields" data-bubble-value="debug" class="mb-4 flex flex-wrap gap-4 items-end">
      <label class="form-control">
        <span class="label-text">Retention: days</span>
        <input
          type="number"
          name="debug_days"
          value={@state.debug_days}
          placeholder="Leave blank for no limit"
          aria-label="DEBUG retention days"
          min="0"
          max="90"
          class="input input-bordered input-sm"
        />
      </label>
      <label class="form-control">
        <span class="label-text">Retention: max entries</span>
        <input
          type="number"
          name="debug_max_entries"
          value={@state.debug_max_entries}
          placeholder="Leave blank for no limit"
          aria-label="DEBUG retention max entries"
          min="0"
          max="10000"
          class="input input-bordered input-sm"
        />
      </label>
    </div>

    <%!-- Excessive-logging contextual warning (AC11) — DEBUG only (AC12: no
          warning for INFO). Server-conditionally rendered, same pattern as
          the retention fields above; app.js mirrors this client-side.
          UX-gate advisory: `role="status"` (not `role="alert"`) — this is
          contextual guidance, not an urgent/interrupting error condition;
          matches the codebase's own convention of reserving `role="alert"`
          for actual error flashes (see `Phoenix.Flash.get(@flash, :error)`
          above) and `role="status"`/`aria-live="polite"` for informational
          content. --%>
    <div :if={@state.debug_enabled} id="debug-warning" data-testid="debug-warning" class="alert alert-warning mb-4 max-w-2xl" role="status">
      <p>
        ⚠️ DEBUG logging captures HTTP request/response payloads, including full message content
        (redacted per policy, but even redacted payloads are large). This endpoint is called
        continuously by every connected client. Enabling unbounded collection could rapidly fill
        the database. Consider using War Room mode (see settings below) for a bounded time/count
        capture instead of leaving DEBUG on indefinitely.
      </p>
    </div>
  </div>

  <button type="submit" class="btn btn-primary">Save</button>
</form>
