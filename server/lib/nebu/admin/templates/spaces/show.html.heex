<div class="admin-space-detail" data-page="space-detail">
  <a href="/admin/spaces" class="text-sm text-primary">&larr; Back to Spaces</a>

  <p :if={Phoenix.Flash.get(@flash, :info)} class="alert alert-success my-4" role="status">
    {Phoenix.Flash.get(@flash, :info)}
  </p>
  <p :if={Phoenix.Flash.get(@flash, :error)} class="alert alert-error my-4" role="alert">
    {Phoenix.Flash.get(@flash, :error)}
  </p>

  <p :if={@space == nil} class="text-base-content/70 mt-4">Space not found.</p>

  <div :if={@space != nil}>
    <h1 class="text-2xl font-bold mb-4" data-space-id={@space.room_id}>
      {space_display_name(@space)}
    </h1>

    <p :if={@detail_error} class="text-error mb-4" role="alert">{@detail_error}</p>

    <%!-- Edit name/topic form --%>
    <form
      id="edit-space-form"
      method="post"
      action={"/admin/spaces/" <> URI.encode(@space.room_id, &URI.char_unreserved?(&1))}
      class="mb-8 max-w-lg"
      data-form="edit-space"
    >
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <label class="form-control w-full mb-3">
        <span class="label-text">Name</span>
        <input type="text" name="name" value={@space.name} class="input input-bordered w-full" />
      </label>
      <label class="form-control w-full mb-3">
        <span class="label-text">Topic</span>
        <input type="text" name="topic" value={Map.get(@space, :topic, "")} class="input input-bordered w-full" />
      </label>
      <button type="submit" class="btn btn-primary" role="button">Save</button>
    </form>

    <%!-- Auto-join toggle --%>
    <div class="mb-8">
      <form
        method="post"
        action={"/admin/spaces/" <> URI.encode(@space.room_id, &URI.char_unreserved?(&1)) <> "/auto-join"}
      >
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <label class="cursor-pointer label gap-2 justify-start">
          <span>Auto-join this space for new users</span>
          <button
            type="submit"
            class="btn btn-xs"
            role="switch"
            data-role="auto-join-toggle"
            data-space-id={@space.room_id}
            aria-checked={to_string(@space.is_auto_join)}
            aria-label={"Auto-join " <> space_display_name(@space)}
          >
            {if @space.is_auto_join, do: "On", else: "Off"}
          </button>
        </label>
      </form>
    </div>

    <%!-- Children section --%>
    <div class="mb-8 max-w-2xl" data-section="children">
      <h2 class="text-xl font-semibold mb-2">Child rooms</h2>

      <form
        id="add-child-form"
        method="post"
        action={"/admin/spaces/" <> URI.encode(@space.room_id, &URI.char_unreserved?(&1)) <> "/children"}
        class="flex items-end gap-2 mb-4"
        data-form="add-child"
      >
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <div class="form-control grow">
          <label class="label-text">Child room id</label>
          <input
            type="text"
            name="child_room_id"
            placeholder="!room:server"
            class="input input-bordered w-full"
          />
        </div>
        <button type="submit" class="btn btn-primary" role="button">Add</button>
      </form>

      <p :if={@children == []} class="text-base-content/70">No child rooms.</p>

      <ul :if={@children != []} class="divide-y divide-base-300" role="list">
        <li
          :for={{child_id, _content} <- @children}
          class="flex items-center justify-between py-2"
          data-role="child-row"
          data-child-id={child_id}
        >
          <span class="font-mono text-sm">{child_id}</span>
          <form
            method="post"
            action={"/admin/spaces/" <> URI.encode(@space.room_id, &URI.char_unreserved?(&1)) <> "/children/" <> URI.encode(child_id, &URI.char_unreserved?(&1))}
          >
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input type="hidden" name="_method" value="DELETE" />
            <button type="submit" class="btn btn-sm btn-error">Remove</button>
          </form>
        </li>
      </ul>
    </div>

    <%!-- Members section --%>
    <div class="mb-8 max-w-2xl" data-section="members">
      <h2 class="text-xl font-semibold mb-2">Add member</h2>

      <p :if={@member_error} class="text-error mb-3" role="alert" data-role="member-error">
        {@member_error}
      </p>

      <form
        id="space-add-member-form"
        method="post"
        action={"/admin/spaces/" <> URI.encode(@space.room_id, &URI.char_unreserved?(&1)) <> "/members"}
        class="flex items-end gap-2"
        data-form="add-member"
      >
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <div class="form-control grow">
          <label class="label-text">Add user</label>
          <input
            type="text"
            name="user_id"
            placeholder="@user:server"
            class="input input-bordered w-full"
            data-field="add-member-user-id"
            autocomplete="off"
            aria-label="Matrix user id to add"
          />
        </div>
        <button type="submit" class="btn btn-primary" role="button">Add</button>
      </form>

      <ul :if={@members != []} class="divide-y divide-base-300 mt-4" role="list">
        <li
          :for={member <- @members}
          class="flex items-center py-2"
          data-role="member-row"
          data-user-id={member.user_id}
        >
          <span class="font-mono text-sm">{member.user_id}</span>
        </li>
      </ul>
    </div>
  </div>
</div>
