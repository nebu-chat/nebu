<div class="admin-oauth-clients" data-page="oauth-clients">
  <h1 class="text-2xl font-bold mb-2">Approved OAuth Clients</h1>
  <p class="text-base-content/70 mb-4">
    Applications an administrator approved. They can sign in your users until you revoke them.
    Revoking ends their sessions, removes their devices and can never be undone for the same registration.
  </p>
  <p class="alert alert-warning mb-4 text-sm" role="note" data-role="unverified-claims-note">
    The client name is a claim made by the registering application and is NOT verified. The Host column is
    taken from its client URI when it registered.
  </p>

  <p :if={Phoenix.Flash.get(@flash, :info)} class="alert alert-success my-4" role="status" data-role="toast" data-toast-kind="success">
    {Phoenix.Flash.get(@flash, :info)}
  </p>
  <p :if={Phoenix.Flash.get(@flash, :error)} class="alert alert-error my-4" role="alert" data-role="toast" data-toast-kind="error">
    {Phoenix.Flash.get(@flash, :error)}
  </p>

  <p :if={not @oauth_enabled} class="alert alert-warning my-4" role="status" data-role="oauth-disabled-notice">
    OAuth is currently disabled on this server. Approved clients stay approved but cannot sign in until it is enabled.
  </p>

  <p class="mb-4">
    <a href="/admin/oauth/clients/revoked" class="link link-primary" data-role="to-revoked">Revoked clients</a>
  </p>

  <p :if={@clients == [] and not @load_error} class="text-base-content/70" data-role="no-approved-clients">
    No approved clients.
  </p>

  <div :if={@clients != []} class="mb-3" data-role="clients-summary" data-total={@total} data-page={@page} data-total-pages={@total_pages}>
    <p>
      {plural(@total, "approved client", "approved clients")} &mdash; page {@page} of {@total_pages}
    </p>
  </div>

  <div :if={@clients != []} class="overflow-x-auto" tabindex="0" role="region" aria-label="Approved OAuth clients">
    <table class="table table-zebra w-full">
      <caption class="sr-only">Approved OAuth clients, newest approval first</caption>
      <thead>
        <tr>
          <th scope="col">Client (unverified)</th>
          <th scope="col">Host</th>
          <th scope="col">Type</th>
          <th scope="col">Approved by</th>
          <th scope="col">Approved at</th>
          <th scope="col">Last used</th>
          <th scope="col">Signed-in devices</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={client <- @clients} data-role="oauth-approved-row" data-client-id={client.client_id}>
          <th scope="row" data-field="client-name" class="max-w-xs break-all text-left">{display_name(client)}</th>
          <td data-field="client-host" class="max-w-xs break-all">
            <span :if={client.client_host} class="font-semibold" data-role="client-host">{client.client_host}</span>
            <span :if={!client.client_host} class="text-base-content/70">(no host stored)</span>
          </td>
          <td data-field="application-type">{application_type_label(client.application_type)}</td>
          <td data-field="approved-by" class="break-all">{client.approved_by}</td>
          <td data-field="approved-at">{format_time(client.approved_at)}</td>
          <td data-field="last-used">{format_time(client.last_used_at)}</td>
          <td data-field="sessions">{sessions_text(client.sessions)}<span :if={client.sessions == :unknown}> (could not be read)</span></td>
          <td>
            <a
              href={revoke_href(client.client_id)}
              class="btn btn-sm btn-error btn-outline"
              data-role="revoke-client"
              aria-label={"Revoke " <> display_name(client) <> " (" <> (client.client_host || client.client_id) <> ")"}
            >
              Revoke
            </a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <nav :if={@total_pages > 1} class="mt-4 flex items-center gap-3" aria-label="Pagination" data-role="pagination">
    <a :if={@page > 1} href={page_href(list_path(), @page - 1)} class="btn btn-sm" data-role="page-prev" rel="prev">Previous page</a>
    <span data-role="page-indicator">Page {@page} of {@total_pages}</span>
    <a :if={@page < @total_pages} href={page_href(list_path(), @page + 1)} class="btn btn-sm" data-role="page-next" rel="next">Next page</a>
  </nav>
</div>
