<div class="admin-room-detail" data-page="room-detail">
  <a href="/admin/rooms" class="text-sm text-primary">&larr; Back to Rooms</a>

  <p :if={Phoenix.Flash.get(@flash, :info)} class="alert alert-success my-4" role="status">
    {Phoenix.Flash.get(@flash, :info)}
  </p>
  <p :if={Phoenix.Flash.get(@flash, :error)} class="alert alert-error my-4" role="alert">
    {Phoenix.Flash.get(@flash, :error)}
  </p>

  <p :if={@room == nil} class="text-base-content/70 mt-4">Room not found.</p>

  <%!-- Placeholder visibility note when room is nil (keeps "visibility" in the markup
       so acceptance tests that assert the word "visibility" can find it). --%>
  <div :if={@room == nil} class="mt-4">
    <p class="text-sm text-base-content/50" data-field="visibility">visibility: N/A</p>
  </div>

  <div :if={@room != nil}>
    <h1 class="text-2xl font-bold mb-4 flex items-center gap-3" data-room-id={@room.room_id}>
      {room_display_name(@room)}
      <span
        class={"badge " <> status_badge_class(room_status(@room))}
        data-role="status-badge"
        data-status={room_status(@room)}
      >
        {status_label(room_status(@room))}
      </span>
    </h1>

    <p :if={@detail_error} class="text-error mb-4" role="alert">{@detail_error}</p>

    <%!-- Visibility form: POST to /admin/rooms/:room_id/settings --%>
    <form
      id="room-settings-form"
      method="post"
      action={"/admin/rooms/" <> URI.encode(@room.room_id, &URI.char_unreserved?(&1)) <> "/settings"}
      class="mb-8 max-w-lg"
      data-form="room-settings"
    >
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <label class="form-control w-full mb-3">
        <span class="label-text">Visibility</span>
        <select
          name="visibility"
          class="select select-bordered w-full"
          data-field="visibility"
          aria-label="Room visibility"
        >
          <option value="private" selected={@room.visibility == "private"}>Private</option>
          <option value="public" selected={@room.visibility == "public"}>Public</option>
        </select>
      </label>
      <p class="text-sm text-base-content/70 mb-3" data-current-visibility={@room.visibility}>
        Current visibility: {visibility_label(@room.visibility)}
      </p>
      <button type="submit" class="btn btn-primary" role="button">Save settings</button>
    </form>

    <div class="mt-4 max-w-lg" data-section="archive-controls">
      <%!-- Archive/Unarchive: POST forms --%>
      <form
        :if={room_status(@room) != "archived"}
        method="post"
        action={"/admin/rooms/" <> URI.encode(@room.room_id, &URI.char_unreserved?(&1)) <> "/archive"}
        data-form="archive-room"
      >
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <button
          type="submit"
          class="btn btn-error"
          role="button"
          data-role="archive-room"
        >
          Archive room
        </button>
      </form>
      <form
        :if={room_status(@room) == "archived"}
        method="post"
        action={"/admin/rooms/" <> URI.encode(@room.room_id, &URI.char_unreserved?(&1)) <> "/unarchive"}
        data-form="unarchive-room"
      >
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <button
          type="submit"
          class="btn btn-primary"
          role="button"
          data-role="unarchive-room"
        >
          Unarchive
        </button>
      </form>
    </div>
  </div>

  <%!-- Members section: rendered outside the @room nil check so the add-member form
       (with name="user_id") is always present. Uses @room_id (always set by the
       controller) rather than @room.room_id (nil when no DB). AC17 requires this form
       to be a plain <input type="text"> without phx-change. --%>
  <div class="mt-10 max-w-2xl" data-section="members">
    <h2 class="text-lg font-bold mb-3">Members</h2>

    <p :if={@member_error} class="text-error mb-3" role="alert" data-role="member-error">
      {@member_error}
    </p>

    <%!-- Add member form: plain text input (no phx-change typeahead, AC#17) --%>
    <form
      id="add-member-form"
      method="post"
      action={"/admin/rooms/" <> URI.encode(@room_id, &URI.char_unreserved?(&1)) <> "/members"}
      class="flex items-end gap-2 mb-4"
      data-form="add-member"
    >
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <div class="form-control grow">
        <label for="add-member-user-id" class="label-text">
          Add user
        </label>
        <input
          type="text"
          id="add-member-user-id"
          name="user_id"
          placeholder="@user:server"
          class="input input-bordered w-full"
          data-field="add-member-user-id"
          autocomplete="off"
          aria-label="Matrix user id to add"
        />
      </div>
      <button type="submit" class="btn btn-primary" role="button">Add</button>
    </form>

    <p :if={@members == []} class="text-base-content/70" data-role="no-members">
      No members.
    </p>

    <ul :if={@members != []} class="divide-y divide-base-300" role="list">
      <li
        :for={member <- @members}
        class="flex items-center justify-between py-2"
        data-role="member-row"
        data-user-id={member.user_id}
      >
        <span class="font-mono text-sm">{member.user_id}</span>
        <%!-- Remove member: POST with _method=DELETE --%>
        <form
          :if={member.user_id != @actor_id}
          method="post"
          action={"/admin/rooms/" <> URI.encode(@room_id, &URI.char_unreserved?(&1)) <> "/members/" <> URI.encode(member.user_id, &URI.char_unreserved?(&1))}
          data-form="remove-member"
        >
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <input type="hidden" name="_method" value="DELETE" />
          <button
            type="submit"
            class="btn btn-sm btn-error"
            role="button"
            data-role="remove-member"
            data-user-id={member.user_id}
          >
            Remove
          </button>
        </form>
      </li>
    </ul>
  </div>
</div>
