<div class="admin-rooms-new" data-page="rooms-new">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold">Create Room</h1>
    <a href="/admin/rooms" class="btn btn-ghost btn-sm">Back to rooms</a>
  </div>

  <form method="post" action="/admin/rooms" class="max-w-md flex flex-col gap-4">
    <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

    <div>
      <label for="room-name" class="block text-sm mb-1">Room name (1–100 characters)</label>
      <input
        id="room-name"
        type="text"
        name="name"
        placeholder="e.g. general"
        class="input input-bordered w-full"
        maxlength="100"
        required
      />
    </div>

    <div>
      <label for="room-visibility" class="block text-sm mb-1">Visibility</label>
      <select id="room-visibility" name="visibility" class="select select-bordered w-full">
        <option value="private">Private</option>
        <option value="public">Public</option>
      </select>
    </div>

    <button type="submit" class="btn btn-primary self-start">Create room</button>
  </form>
</div>
