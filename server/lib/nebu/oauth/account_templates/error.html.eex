<%= @icon %>
<h1><%= @heading %></h1>
<p><%= @explanation %></p>
<p class="primary"><strong><%= @primary %></strong></p>
<%= if @more != [] do %>
<details>
<summary><%= @more_label %></summary>
<ul>
<%= for item <- @more do %>
<li><%= item %></li>
<% end %>
</ul>
</details>
<% end %>
<%= if @restart do %>
<p><a class="btn" href="/account"><%= @restart_label %></a></p>
<% end %>
