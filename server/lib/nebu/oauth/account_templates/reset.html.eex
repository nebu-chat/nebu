<p><%= t(@lang, "acct.reset.intro") %></p>
<%= if @requests == [] do %>
<p data-role="no-requests"><%= t(@lang, "acct.reset.none") %></p>
<% else %>
<%= if !@fresh and !@no_auth_time do %>
<p><%= t(@lang, "acct.reset.reauth") %></p>
<p><a data-role="reauth" class="btn primary" href="<%= @reauth_href %>"><%= t(@lang, "acct.reauth.button") %></a></p>
<% end %>
<%= if @several do %>
<div class="notice error icon" role="alert" data-role="reset-several"><%= @problem_icon %><p><strong><%= t(@lang, "acct.label.problem") %></strong> <%= tf(@lang, "acct.reset.several", %{"n" => length(@requests)}) %></p></div>
<% end %>
<%= for r <- @requests do %>
<section class="card" data-role="reset-request" aria-labelledby="request-<%= r.session_id %>">
<h2 id="request-<%= r.session_id %>"><%= tf(@lang, "acct.reset.request_from", %{"device" => request_device(r, @lang)}) %></h2>
<dl>
<dt><%= t(@lang, "acct.reset.d.app") %></dt>
<dd><%= request_app(r, @lang) %></dd>
<dt><%= t(@lang, "acct.reset.d.last_active") %></dt>
<dd><%= time_tag(r.device_last_seen_ts, t(@lang, "acct.never")) %></dd>
<dt><%= t(@lang, "acct.reset.d.requested") %></dt>
<dd><%= time_tag(r.requested_at * 1000, t(@lang, "rel.now")) %> (<%= relative_time(r.requested_at, @lang) %>)</dd>
<dt><%= t(@lang, "acct.reset.d.expires") %></dt>
<dd><%= time_tag(r.expires_at * 1000, t(@lang, "acct.reset.soon")) %> (<%= relative_time(r.expires_at, @lang) %>)</dd>
<%= if r.keys_fingerprint do %>
<dt><%= t(@lang, "acct.reset.d.reference") %></dt>
<dd><%= r.keys_fingerprint %></dd>
<% end %>
</dl>
<p><%= t(@lang, "acct.reset.warn") %></p>
<p><%= t(@lang, "acct.reset.decline_note") %></p>
<%= if @fresh do %>
<div class="actions">
<form method="post" action="/account/cross_signing_reset/decline">
<input type="hidden" name="session_id" value="<%= r.session_id %>">
<input type="hidden" name="csrf_token" value="<%= @csrf_token %>">
<button type="submit" class="btn secondary" data-role="decline-reset" aria-label="<%= tf(@lang, "acct.reset.decline_label", %{"device" => request_device(r, @lang)}) %>"><%= t(@lang, "acct.reset.decline") %></button>
</form>
<%= if !@several do %>
<form method="post" action="/account/cross_signing_reset/approve">
<input type="hidden" name="session_id" value="<%= r.session_id %>">
<input type="hidden" name="csrf_token" value="<%= @csrf_token %>">
<input type="hidden" name="_click_proof" value="" data-click-proof>
<button type="submit" class="btn danger" data-role="approve-reset" aria-label="<%= tf(@lang, "acct.reset.approve_label", %{"device" => request_device(r, @lang)}) %>"><%= t(@lang, "acct.reset.approve") %></button>
</form>
<% end %>
</div>
<% end %>
</section>
<% end %>
<% end %>
