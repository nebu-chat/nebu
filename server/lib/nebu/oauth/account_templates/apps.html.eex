<p data-role="grants-note"><%= t(@lang, "acct.apps.note") %></p>
<%= if @grants == [] do %>
<p data-role="no-grants"><%= t(@lang, "acct.apps.empty") %></p>
<% else %>
<ul class="cards" data-role="grant-list">
<%= for g <- @grants do %>
<li class="card" data-role="consent-grant" data-client-id="<%= g.client_id %>">
<div class="top">
<div>
<h2 data-role="grant-name"><%= grant_name(g, @lang) %></h2>
<p class="meta"><%= t(@lang, "acct.apps.website") %>: <%= if g.client_host in [nil, ""], do: t(@lang, "acct.unknown"), else: g.client_host %> · <%= t(@lang, "acct.apps.allowed_on") %> <%= grant_time(g.granted_at, @lang) %></p>
</div>
<form method="post" action="/account/apps/withdraw">
<input type="hidden" name="csrf_token" value="<%= @csrf_token %>">
<input type="hidden" name="client_id" value="<%= g.client_id %>">
<button type="submit" class="btn danger" data-role="withdraw-grant" aria-label="<%= tf(@lang, "acct.apps.withdraw_label", %{"name" => grant_name(g, @lang), "host" => grant_host(g, @lang)}) %>"><%= t(@lang, "acct.apps.withdraw") %></button>
</form>
</div>
</li>
<% end %>
</ul>
<% end %>
<details data-role="grants-details">
<summary><%= t(@lang, "acct.apps.details_summary") %></summary>
<p><%= t(@lang, "acct.apps.details") %></p>
<p><a href="/account?action=org.matrix.devices_list"><%= t(@lang, "acct.nav.devices") %></a></p>
</details>
