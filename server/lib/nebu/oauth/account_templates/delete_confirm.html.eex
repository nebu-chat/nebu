<dl>
<dt><%= t(@lang, "acct.device.d.name") %></dt>
<dd><%= device_name(@device, @lang) %></dd>
<dt><%= t(@lang, "acct.device.d.id") %></dt>
<dd><%= @device.device_id %></dd>
<dt><%= t(@lang, "acct.device.d.app") %></dt>
<dd><%= app_label(@device, @lang) %></dd>
</dl>
<p><%= t(@lang, "acct.delete.explain") %></p>
<%= if @fresh do %>
<form method="post" action="/account/devices/delete">
<input type="hidden" name="device_id" value="<%= @device.device_id %>">
<input type="hidden" name="csrf_token" value="<%= @csrf_token %>">
<button type="submit" class="btn danger" data-role="delete-device-confirm"><%= tf(@lang, "acct.delete.confirm", %{"name" => device_name(@device, @lang)}) %></button>
</form>
<% else %>
<%= if !@no_auth_time do %>
<p><%= t(@lang, "acct.delete.reauth") %></p>
<p><a data-role="reauth" class="btn primary" href="<%= @reauth_href %>"><%= t(@lang, "acct.reauth.button") %></a></p>
<% end %>
<% end %>
<p><a data-role="cancel" class="btn secondary" href="/account?action=org.matrix.devices_list"><%= t(@lang, "acct.delete.cancel") %></a></p>
