# CI image of the Elixir jobs (test-unit-elixir, secret-scan, verify-docs, integration-test-k8s), built by `build-ci-elixir` in .gitlab-ci.yml.
#
# The registry TAG (CI_ELIXIR_IMAGE in .gitlab-ci.yml, ci-elixir:1.20.5) names the exact Elixir version of the FROM line below. The FROM has the
# same Elixir patch and OTP major as the production image (server/Dockerfile: elixir:1.20.5-otp-29), on Alpine instead of Debian because the
# CI jobs do not build the release. It is pinned by digest (container-hardening guideline; the digest is the multi-arch index of the tag, Renovate
# bumps tag + digest together). Bumping the Elixir version means changing this FROM, CI_ELIXIR_IMAGE, ELIXIR_IMAGE in the Makefile and in
# scripts/ci-local.sh together; the changed file makes the pipeline build the image before the unit stage.
FROM elixir:1.20.5-otp-29-alpine@sha256:a2f0fe1bfd8a2f9cc91d913f4a12e6430e27e618720f753a514e2fff3d35f5a7

LABEL org.opencontainers.image.title="nebu ci-elixir" \
      org.opencontainers.image.description="Elixir 1.20.5 / OTP 29 CI image with Hex and rebar3 pre-installed"

# Pre-install hex package manager and rebar3 build tool.
# Eliminates the ~15s `mix local.hex --force && mix local.rebar --force` overhead
# on every CI test run. mix deps.get still runs in the job (project-specific).
RUN mix local.hex --force && mix local.rebar --force

WORKDIR /workspace
