+           secret_access_key: cfg.secret_key,
+           host: host,
+           scheme: if(cfg.use_ssl, do: "https://", else: "http://"),
+           port: port,
+           region: cfg.region
+         ],
+         bucket: cfg.bucket,
+         archive_bucket: effective_archive_bucket(cfg)
+       }}
+    end
+  end
+
+  @doc false
