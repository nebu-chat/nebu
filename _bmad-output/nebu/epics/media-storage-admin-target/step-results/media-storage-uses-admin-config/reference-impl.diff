+  # THROWAWAY REFERENCE (ATDD): per-call target resolution for Nebu.Media.Storage.
+  @doc false
+  @spec operation_target() ::
+          {:ok, %{overrides: keyword(), bucket: String.t(), archive_bucket: String.t()}}
+          | {:error, :storage_endpoint_blank}
+  def operation_target do
+    cfg = get_for_connection()
+    endpoint = if is_binary(cfg.endpoint), do: String.trim(cfg.endpoint), else: ""
+
+    {host, port} =
+      case String.split(endpoint, ":", parts: 2) do
+        [h, p] ->
+          case Integer.parse(String.trim(p)) do
+            {n, ""} -> {String.trim(h), n}
