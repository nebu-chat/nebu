+defmodule Nebu.Admin.ReauthComponents do
+  @moduledoc """
+  Story admin-reauth-button-flow: the primary control and the hint of a marker-gated admin form, decided by the SERVER at render time.
+
+  `@reauth` is the assign of `Nebu.Admin.OAuthAdminHelpers.assign_reauth/2`: `%{fresh?, minutes, href}`. Stale = a link styled as a button to the
+  sign-in of the page (`Nebu.Admin.Auth.reauth_start_path/1`), fresh = the normal submit button and a validity line in the hint element.
+  """
+  use Phoenix.Component
+
+  attr :reauth, :map, required: true
+  attr :id, :string, required: true
+  attr :class, :string, default: "mt-2 text-sm text-base-content/70"
+  attr :keys, :boolean, default: false, doc: "the storage target: the access key and the secret key are never filled in"
+  attr :action, :string, default: "save"
+
+  def reauth_hint(assigns) do
+    ~H"""
+    <p id={@id} class={@class}>
+      <%= if @reauth.fresh? do %>
+        Your fresh sign-in is valid for {validity(@reauth.minutes)} and for one {@action}.
+      <% else %>
+        Sign in again first: you come back to this page and can then enter your change and save it.
+        <%= if @keys do %>
+          The access key and the secret key are never filled in for you. Test Connection needs no new sign-in.
+        <% end %>
+      <% end %>
+    </p>
+    """
+  end
+
+  attr :reauth, :map, required: true
+  attr :class, :string, required: true
+  attr :describedby, :string, required: true
+  attr :link_text, :string, default: "Sign in again to save"
+  attr :rest, :global
+
+  slot :inner_block, required: true
+
+  def reauth_control(assigns) do
+    ~H"""
+    <button :if={@reauth.fresh?} type="submit" class={@class} aria-describedby={@describedby} {@rest}>{render_slot(@inner_block)}</button>
+    <a :if={!@reauth.fresh?} href={@reauth.href} class={@class} aria-describedby={@describedby}>{@link_text}</a>
+    """
+  end
+
+  @doc "`1 minute`, `N more minutes`... as text: the remaining whole minutes (rounded down), `less than a minute` below 60 s."
+  def validity(0), do: "less than a minute"
+  def validity(1), do: "1 minute"
+  def validity(n) when is_integer(n), do: "#{n} minutes"
+end
