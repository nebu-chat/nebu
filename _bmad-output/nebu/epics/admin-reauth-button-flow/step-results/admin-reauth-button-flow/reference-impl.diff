+  @doc """
+  Read only (story admin-reauth-button-flow): the remaining validity of the fresh re-authentication marker for `path` as WHOLE minutes, rounded down
+  (`{:ok, 0}` = less than a minute, never more than 5), or `:stale` exactly when `reauth_fresh/2` is `:stale`. Writes nothing.
+  """
+  @spec reauth_remaining_minutes(Plug.Conn.t(), String.t()) :: {:ok, 0..5} | :stale
+  def reauth_remaining_minutes(conn, path) when is_binary(path) do
+    with {:ok, _kind} <- reauth_fresh(conn, path),
+         %{"at" => at} when is_integer(at) <- get_session(conn, @reauth_session_key) do
+      remaining = @reauth_ttl_seconds - (System.system_time(:second) - at)
+      {:ok, div(min(max(remaining, 0), @reauth_ttl_seconds), 60)}
+    else
+      _ -> :stale
+    end
+  end
+
