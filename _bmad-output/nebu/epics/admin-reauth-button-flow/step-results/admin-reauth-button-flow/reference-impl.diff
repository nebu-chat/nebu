@@ -152,6 +152,20 @@ defmodule Nebu.Admin.OAuthAdminHelpers do
     |> halt()
   end
 
+  @doc """
+  Story admin-reauth-button-flow: assigns `:reauth` = `%{fresh?, minutes, href}` for the marker-gated form(s) bound to `path` (the page path the marker is bound to):
+  decided now by `Auth.reauth_fresh/2` (through `Auth.reauth_remaining_minutes/2`), the href is `Auth.reauth_start_path(path)`, built from the server side path only.
+  """
+  @spec assign_reauth(Plug.Conn.t(), String.t()) :: Plug.Conn.t()
+  def assign_reauth(conn, path) do
+    href = Auth.reauth_start_path(path)
+
+    case Auth.reauth_remaining_minutes(conn, path) do
+      {:ok, minutes} -> assign(conn, :reauth, %{fresh?: true, minutes: minutes, href: href})
+      :stale -> assign(conn, :reauth, %{fresh?: false, minutes: nil, href: href})
+    end
+  end
+
