diff --git a/server/lib/nebu/matrix/http_room_keys.ex b/server/lib/nebu/matrix/http_room_keys.ex
new file mode 100644
index 00000000..f579ea7d
--- /dev/null
+++ b/server/lib/nebu/matrix/http_room_keys.ex
@@ -0,0 +1,559 @@
+defmodule Nebu.Matrix.HttpRoomKeys do
+  @moduledoc """
+  Matrix CS v1.18 "Server-side key backups" (`/_matrix/client/v3/room_keys/**`), story server-side-key-backup (epic e2ee-client-support).
+
+  An OPAQUE per-user store (ADR-011 stays: this enables no E2EE room): `auth_data` and the `session_data` blobs are kept verbatim as JSON text and
+  never decrypted or parsed beyond well-formedness and size. SQL inline (ADR-018). State lives only in PostgreSQL (`room_key_backup_versions`,
+  `room_key_backup_sessions`): `count` and `etag` come from the database, so every node of a cluster answers the same.
+
+  Every write runs in one transaction under the per-user `sync_global` advisory lock (the SAME key as `AccountDataStore.put/3` and
+  `CrossSigningKeyStore.put_keys/2`): the merge, the quota and the version number are decided on the locked state and the erasure serialises with them.
+  Nothing here logs a blob; a failing write logs its error KIND only.
+  """
+  import Nebu.Matrix.Http, only: [send_json: 3, error: 4]
+  require Logger
+
+  @algorithm "m.megolm_backup.v1.curve25519-aes-sha2"
+  @max_versions 10
+  @default_max_sessions 100_000
+  @max_session_data_bytes 8 * 1024
+  @max_auth_data_bytes 16 * 1024
+  @max_id_bytes 255
+  @max_index 4_294_967_295
+  @lock_sql "SELECT pg_advisory_xact_lock(hashtextextended('sync_global|' || $1::text, 0))"
+
+  # ── versions ────────────────────────────────────────────────────────────────
+
+  @doc "POST /room_keys/version"
+  def create_version(conn) do
+    with {:ok, body} <- body_object(conn),
+         {:ok, algorithm, auth_data} <- version_body(body) do
+      uid = conn.assigns[:current_user]
+      now = now_ms()
+
+      transact(conn, fn ->
+        lock_and_check_erased!(uid)
+        %{rows: [[live]]} = q!("SELECT count(*) FROM room_key_backup_versions WHERE user_id = $1 AND deleted_at IS NULL", [uid])
+        if live >= @max_versions, do: fail(403, "M_FORBIDDEN", "Too many key backup versions (at most #{@max_versions}); delete one first")
+        %{rows: [[next]]} = q!("SELECT COALESCE(max(version), 0) + 1 FROM room_key_backup_versions WHERE user_id = $1", [uid])
+
+        q!(
+          "INSERT INTO room_key_backup_versions (user_id, version, algorithm, auth_data, etag, created_at, updated_at) VALUES ($1, $2, $3, $4, 0, $5, $5)",
+          [uid, next, algorithm, Jason.encode!(auth_data), now]
+        )
+
+        {200, %{"version" => Integer.to_string(next)}}
+      end)
+    else
+      {:error, err} -> api_error(conn, err)
+    end
+  end
+
+  @doc "GET /room_keys/version (the current version) and GET /room_keys/version/{version}"
+  def get_version(conn, version \\ nil) do
+    uid = conn.assigns[:current_user]
+
+    guard_read(conn, fn ->
+      v =
+        if version == nil do
+          current_version(uid)
+        else
+          case parse_version(version) do
+            {:ok, v} -> v
+            :error -> nil
+          end
+        end
+
+      if v == nil, do: not_found(conn, version), else: reply_info(conn, uid, v, version)
+    end)
+  end
+
+  defp reply_info(conn, uid, v, version) do
+    case q("SELECT algorithm, auth_data, etag FROM room_key_backup_versions WHERE user_id = $1 AND version = $2 AND deleted_at IS NULL", [uid, v]) do
+      {:ok, %{rows: [[algorithm, auth_data, etag]]}} ->
+        %{rows: [[count]]} = q!("SELECT count(*) FROM room_key_backup_sessions WHERE user_id = $1 AND version = $2", [uid, v])
+
+        send_json(conn, 200, %{
+          "algorithm" => algorithm,
+          "auth_data" => Jason.decode!(auth_data),
+          "count" => count,
+          "etag" => Integer.to_string(etag),
+          "version" => Integer.to_string(v)
+        })
+
+      {:ok, _} ->
+        not_found(conn, version)
+
+      {:error, e} ->
+        internal(conn, e)
+    end
+  end
+
+  @doc "PUT /room_keys/version/{version}"
+  def update_version(conn, version) do
+    uid = conn.assigns[:current_user]
+
+    with {:ok, body} <- body_object(conn),
+         {:ok, algorithm, auth_data} <- update_body(body) do
+      transact(conn, fn ->
+        lock!(uid)
+
+        v =
+          case parse_version(version) do
+            {:ok, v} -> v
+            :error -> fail(404, "M_NOT_FOUND", "Unknown backup version")
+          end
+
+        case q!("SELECT algorithm FROM room_key_backup_versions WHERE user_id = $1 AND version = $2 AND deleted_at IS NULL FOR UPDATE", [uid, v]) do
+          %{rows: [[stored]]} ->
+            if algorithm != stored, do: fail(400, "M_INVALID_PARAM", "The algorithm of a backup cannot be changed")
+
+            case Map.fetch(body, "version") do
+              {:ok, ^version} -> :ok
+              {:ok, _} -> fail(400, "M_INVALID_PARAM", "The version in the body does not match the version in the path")
+              :error -> :ok
+            end
+
+            q!("UPDATE room_key_backup_versions SET auth_data = $3, updated_at = $4 WHERE user_id = $1 AND version = $2", [uid, v, Jason.encode!(auth_data), now_ms()])
+            {200, %{}}
+
+          _ ->
+            fail(404, "M_NOT_FOUND", "Unknown backup version")
+        end
+      end)
+    else
+      {:error, err} -> api_error(conn, err)
+    end
+  end
+
+  @doc "DELETE /room_keys/version/{version}"
+  def delete_version(conn, version) do
+    uid = conn.assigns[:current_user]
+
+    transact(conn, fn ->
+      lock!(uid)
+
+      v =
+        case parse_version(version) do
+          {:ok, v} -> v
+          :error -> fail(404, "M_NOT_FOUND", "Unknown backup version")
+        end
+
+      case q!("SELECT deleted_at FROM room_key_backup_versions WHERE user_id = $1 AND version = $2 FOR UPDATE", [uid, v]) do
+        %{rows: []} ->
+          fail(404, "M_NOT_FOUND", "Unknown backup version")
+
+        %{rows: [[nil]]} ->
+          q!("DELETE FROM room_key_backup_sessions WHERE user_id = $1 AND version = $2", [uid, v])
+          now = now_ms()
+
+          q!(
+            "UPDATE room_key_backup_versions SET algorithm = NULL, auth_data = NULL, etag = etag + 1, deleted_at = $3, updated_at = $3 WHERE user_id = $1 AND version = $2",
+            [uid, v, now]
+          )
+
+          {200, %{}}
+
+        %{rows: [[_deleted_at]]} ->
+          {200, %{}}
+      end
+    end)
+  end
+
+  # ── keys ────────────────────────────────────────────────────────────────────
+
+  @doc "PUT /room_keys/keys[/{room}[/{session}]]; `scope` is `:all`, `{:room, room}` or `{:session, room, session}`"
+  def put_keys(conn, scope) do
+    uid = conn.assigns[:current_user]
+
+    with {:ok, version} <- version_param(conn),
+         :ok <- scope_ids(scope),
+         {:ok, body} <- body_object(conn),
+         {:ok, entries} <- parse_entries(scope, body) do
+      transact(conn, fn ->
+        lock_and_check_erased!(uid)
+
+        v =
+          case current_version(uid) do
+            nil ->
+              fail(404, "M_NOT_FOUND", "Unknown backup version")
+
+            current ->
+              if parse_version(version) != {:ok, current},
+                do: fail(403, "M_WRONG_ROOM_KEYS_VERSION", "The version is not the current backup version", %{"current_version" => Integer.to_string(current)})
+
+              current
+          end
+
+        store!(uid, v, entries)
+        {200, count_etag(uid, v)}
+      end)
+    else
+      {:error, err} -> api_error(conn, err)
+    end
+  end
+
+  defp store!(_uid, _v, []), do: :ok
+
+  defp store!(uid, v, entries) do
+    rooms = Enum.map(entries, & &1.room_id)
+    sids = Enum.map(entries, & &1.session_id)
+    fmis = Enum.map(entries, & &1.first_message_index)
+    fwds = Enum.map(entries, & &1.forwarded_count)
+    vers = Enum.map(entries, & &1.is_verified)
+    datas = Enum.map(entries, & &1.session_data)
+
+    %{rows: [[existing]]} = q!("SELECT count(*) FROM room_key_backup_sessions WHERE user_id = $1 AND version = $2", [uid, v])
+
+    %{rows: [[fresh]]} =
+      q!(
+        "SELECT count(*) FROM unnest($3::text[], $4::text[]) AS i(room_id, session_id) WHERE NOT EXISTS " <>
+          "(SELECT 1 FROM room_key_backup_sessions s WHERE s.user_id = $1 AND s.version = $2 AND s.room_id = i.room_id AND s.session_id = i.session_id)",
+        [uid, v, rooms, sids]
+      )
+
+    if existing + fresh > max_sessions(), do: fail(403, "M_FORBIDDEN", "Too many sessions in this backup version")
+
+    # the merge rule of the spec, in order: verified wins; else the lower first_message_index; if equal the lower forwarded_count; a full tie keeps the stored one
+    %{rows: [[changed]]} =
+      q!(
+        """
+        WITH upserted AS (
+          INSERT INTO room_key_backup_sessions AS s
+            (user_id, version, room_id, session_id, first_message_index, forwarded_count, is_verified, session_data, updated_at)
+          SELECT $1::text, $2::bigint, i.room_id, i.session_id, i.fmi, i.fwd, i.ver, i.data, $9::bigint
+          FROM unnest($3::text[], $4::text[], $5::bigint[], $6::bigint[], $7::boolean[], $8::text[]) AS i(room_id, session_id, fmi, fwd, ver, data)
+          ON CONFLICT (user_id, version, room_id, session_id) DO UPDATE
+            SET first_message_index = EXCLUDED.first_message_index,
+                forwarded_count     = EXCLUDED.forwarded_count,
+                is_verified         = EXCLUDED.is_verified,
+                session_data        = EXCLUDED.session_data,
+                updated_at          = EXCLUDED.updated_at
+            WHERE (EXCLUDED.is_verified AND NOT s.is_verified)
+               OR (EXCLUDED.is_verified = s.is_verified
+                   AND (EXCLUDED.first_message_index < s.first_message_index
+                        OR (EXCLUDED.first_message_index = s.first_message_index AND EXCLUDED.forwarded_count < s.forwarded_count)))
+          RETURNING 1
+        )
+        SELECT count(*) FROM upserted
+        """,
+        [uid, v, rooms, sids, fmis, fwds, vers, datas, now_ms()]
+      )
+
+    if changed > 0, do: bump_etag!(uid, v)
+    :ok
+  end
+
+  @doc "GET /room_keys/keys[/{room}[/{session}]]"
+  def get_keys(conn, scope) do
+    uid = conn.assigns[:current_user]
+
+    with {:ok, version} <- version_param(conn),
+         :ok <- scope_ids(scope) do
+      guard_read(conn, fn ->
+        case live_version(uid, version) do
+          nil -> not_found(conn, version)
+          v -> send_keys(conn, uid, v, scope)
+        end
+      end)
+    else
+      {:error, err} -> api_error(conn, err)
+    end
+  end
+
+  defp send_keys(conn, uid, v, :all) do
+    %{rows: rows} = q!("SELECT room_id, session_id, first_message_index, forwarded_count, is_verified, session_data FROM room_key_backup_sessions WHERE user_id = $1 AND version = $2", [uid, v])
+
+    rooms =
+      Enum.reduce(rows, %{}, fn [room, sid | rest], acc ->
+        Map.update(acc, room, %{"sessions" => %{sid => kbd(rest)}}, fn %{"sessions" => s} -> %{"sessions" => Map.put(s, sid, kbd(rest))} end)
+      end)
+
+    send_json(conn, 200, %{"rooms" => rooms})
+  end
+
+  defp send_keys(conn, uid, v, {:room, room}) do
+    %{rows: rows} = q!("SELECT session_id, first_message_index, forwarded_count, is_verified, session_data FROM room_key_backup_sessions WHERE user_id = $1 AND version = $2 AND room_id = $3", [uid, v, room])
+    send_json(conn, 200, %{"sessions" => Map.new(rows, fn [sid | rest] -> {sid, kbd(rest)} end)})
+  end
+
+  defp send_keys(conn, uid, v, {:session, room, session}) do
+    case q!("SELECT first_message_index, forwarded_count, is_verified, session_data FROM room_key_backup_sessions WHERE user_id = $1 AND version = $2 AND room_id = $3 AND session_id = $4", [uid, v, room, session]) do
+      %{rows: [row]} -> send_json(conn, 200, kbd(row))
+      _ -> error(conn, 404, "M_NOT_FOUND", "Unknown key")
+    end
+  end
+
+  defp kbd([fmi, fwd, verified, data]), do: %{"first_message_index" => fmi, "forwarded_count" => fwd, "is_verified" => verified, "session_data" => Jason.decode!(data)}
+
+  @doc "DELETE /room_keys/keys[/{room}[/{session}]]"
+  def delete_keys(conn, scope) do
+    uid = conn.assigns[:current_user]
+
+    with {:ok, version} <- version_param(conn),
+         :ok <- scope_ids(scope) do
+      transact(conn, fn ->
+        lock!(uid)
+
+        v =
+          case live_version(uid, version) do
+            nil -> fail(404, "M_NOT_FOUND", "Unknown backup version")
+            v -> v
+          end
+
+        %{num_rows: deleted} =
+          case scope do
+            :all -> q!("DELETE FROM room_key_backup_sessions WHERE user_id = $1 AND version = $2", [uid, v])
+            {:room, room} -> q!("DELETE FROM room_key_backup_sessions WHERE user_id = $1 AND version = $2 AND room_id = $3", [uid, v, room])
+            {:session, room, session} -> q!("DELETE FROM room_key_backup_sessions WHERE user_id = $1 AND version = $2 AND room_id = $3 AND session_id = $4", [uid, v, room, session])
+          end
+
+        if deleted > 0, do: bump_etag!(uid, v)
+        {200, count_etag(uid, v)}
+      end)
+    else
+      {:error, err} -> api_error(conn, err)
+    end
+  end
+
+  # ── validation ──────────────────────────────────────────────────────────────
+
+  defp body_object(conn) do
+    cond do
+      conn.assigns[:json_parse_error] == true -> {:error, {400, "M_NOT_JSON", "Request body is not valid JSON", %{}}}
+      is_struct(conn.body_params, Plug.Conn.Unfetched) -> {:ok, %{}}
+      is_map(conn.body_params) and map_size(conn.body_params) == 1 and Map.has_key?(conn.body_params, "_json") -> {:error, {400, "M_BAD_JSON", "Request body must be a JSON object", %{}}}
+      is_map(conn.body_params) -> {:ok, conn.body_params}
+      true -> {:ok, %{}}
+    end
+  end
+
+  defp version_param(conn) do
+    case conn.query_params["version"] do
+      v when is_binary(v) and v != "" -> {:ok, v}
+      _ -> {:error, {400, "M_MISSING_PARAM", "Missing the `version` query parameter", %{}}}
+    end
+  end
+
+  defp version_body(body) do
+    with {:ok, algorithm} <- required(body, "algorithm", &is_binary/1),
+         {:ok, auth_data} <- required(body, "auth_data", &is_map/1),
+         :ok <- size_ok(auth_data, @max_auth_data_bytes, "auth_data"),
+         :ok <- if(algorithm == @algorithm, do: :ok, else: {:error, {400, "M_INVALID_PARAM", "Unsupported algorithm", %{}}}) do
+      {:ok, algorithm, auth_data}
+    end
+  end
+
+  defp update_body(body) do
+    with {:ok, algorithm} <- required(body, "algorithm", &is_binary/1),
+         {:ok, auth_data} <- required(body, "auth_data", &is_map/1),
+         :ok <- size_ok(auth_data, @max_auth_data_bytes, "auth_data"),
+         :ok <- optional(body, "version", &is_binary/1) do
+      {:ok, algorithm, auth_data}
+    end
+  end
+
+  defp required(body, key, valid?) do
+    case Map.fetch(body, key) do
+      :error -> {:error, {400, "M_MISSING_PARAM", "Missing #{key}", %{}}}
+      {:ok, value} -> if valid?.(value), do: {:ok, value}, else: {:error, {400, "M_INVALID_PARAM", "Invalid #{key}", %{}}}
+    end
+  end
+
+  defp optional(body, key, valid?) do
+    case Map.fetch(body, key) do
+      :error -> :ok
+      {:ok, value} -> if valid?.(value), do: :ok, else: {:error, {400, "M_INVALID_PARAM", "Invalid #{key}", %{}}}
+    end
+  end
+
+  defp size_ok(value, max, what) do
+    if byte_size(Jason.encode!(value)) > max, do: {:error, {413, "M_TOO_LARGE", "#{what} is too large", %{}}}, else: :ok
+  end
+
+  defp scope_ids(:all), do: :ok
+  defp scope_ids({:room, room}), do: id_ok(room)
+  defp scope_ids({:session, room, session}), do: with(:ok <- id_ok(room), do: id_ok(session))
+
+  defp id_ok(id) do
+    if is_binary(id) and byte_size(id) in 1..@max_id_bytes and String.valid?(id) and not String.contains?(id, <<0>>),
+      do: :ok,
+      else: {:error, {400, "M_INVALID_PARAM", "Invalid room or session id", %{}}}
+  end
+
+  # the body of a key write as a list of validated entries (the whole request or nothing)
+  defp parse_entries(:all, body) do
+    with {:ok, rooms} <- required(body, "rooms", &is_map/1) do
+      flat_map_ok(rooms, fn {room, room_body} ->
+        with :ok <- id_ok(room),
+             {:ok, sessions} <- required(room_body_map(room_body), "sessions", &is_map/1) do
+          sessions_entries(room, sessions)
+        end
+      end)
+    end
+  end
+
+  defp parse_entries({:room, room}, body) do
+    with {:ok, sessions} <- required(body, "sessions", &is_map/1), do: sessions_entries(room, sessions)
+  end
+
+  defp parse_entries({:session, room, session}, body) do
+    with {:ok, entry} <- entry(room, session, body), do: {:ok, [entry]}
+  end
+
+  defp room_body_map(m) when is_map(m), do: m
+  defp room_body_map(_), do: %{"sessions" => :invalid}
+
+  defp sessions_entries(room, sessions) do
+    flat_map_ok(sessions, fn {sid, kbd} ->
+      with :ok <- id_ok(sid), {:ok, entry} <- entry(room, sid, kbd), do: {:ok, [entry]}
+    end)
+  end
+
+  defp entry(room, sid, kbd) when is_map(kbd) do
+    with {:ok, fmi} <- required(kbd, "first_message_index", &index?/1),
+         {:ok, fwd} <- required(kbd, "forwarded_count", &index?/1),
+         {:ok, verified} <- required(kbd, "is_verified", &is_boolean/1),
+         {:ok, data} <- required(kbd, "session_data", &is_map/1),
+         :ok <- size_ok(data, @max_session_data_bytes, "session_data") do
+      {:ok, %{room_id: room, session_id: sid, first_message_index: fmi, forwarded_count: fwd, is_verified: verified, session_data: Jason.encode!(data)}}
+    end
+  end
+
+  defp entry(_room, _sid, _kbd), do: {:error, {400, "M_INVALID_PARAM", "A session must be a JSON object", %{}}}
+
+  defp index?(n), do: is_integer(n) and n >= 0 and n <= @max_index
+
+  defp flat_map_ok(enumerable, fun) do
+    Enum.reduce_while(enumerable, {:ok, []}, fn item, {:ok, acc} ->
+      case fun.(item) do
+        {:ok, list} -> {:cont, {:ok, acc ++ list}}
+        {:error, _} = err -> {:halt, err}
+      end
+    end)
+  end
+
+  # ── versions in the database ────────────────────────────────────────────────
+
+  # a version is a decimal string without a leading zero that fits an int64
+  defp parse_version(version) when is_binary(version) do
+    if Regex.match?(~r/\A[1-9][0-9]{0,17}\z/, version), do: {:ok, String.to_integer(version)}, else: :error
+  end
+
+  defp parse_version(_), do: :error
+
+  defp current_version(uid) do
+    case q!("SELECT max(version) FROM room_key_backup_versions WHERE user_id = $1 AND deleted_at IS NULL", [uid]) do
+      %{rows: [[v]]} -> v
+    end
+  end
+
+  defp live_version(uid, version) do
+    with {:ok, v} <- parse_version(version),
+         %{rows: [[1]]} <- q!("SELECT 1 FROM room_key_backup_versions WHERE user_id = $1 AND version = $2 AND deleted_at IS NULL", [uid, v]) do
+      v
+    else
+      _ -> nil
+    end
+  end
+
+  defp count_etag(uid, v) do
+    %{rows: [[count]]} = q!("SELECT count(*) FROM room_key_backup_sessions WHERE user_id = $1 AND version = $2", [uid, v])
+    %{rows: [[etag]]} = q!("SELECT etag FROM room_key_backup_versions WHERE user_id = $1 AND version = $2", [uid, v])
+    %{"count" => count, "etag" => Integer.to_string(etag)}
+  end
+
+  defp bump_etag!(uid, v), do: q!("UPDATE room_key_backup_versions SET etag = etag + 1, updated_at = $3 WHERE user_id = $1 AND version = $2", [uid, v, now_ms()])
+
+  defp max_sessions do
+    case Application.get_env(:nebu, :room_keys_max_sessions_per_version, @default_max_sessions) do
+      n when is_integer(n) and n > 0 -> n
+      _ -> @default_max_sessions
+    end
+  end
+
+  # ── plumbing ────────────────────────────────────────────────────────────────
+
+  defp now_ms, do: System.system_time(:millisecond)
+
+  defp lock!(uid), do: q!(@lock_sql, [uid])
+
+  defp lock_and_check_erased!(uid) do
+    lock!(uid)
+
+    case q!("SELECT 1 FROM users WHERE user_id = $1 AND deletion_status IS NOT NULL", [uid]) do
+      %{rows: [_ | _]} ->
+        Logger.info("room keys write refused: user_erased")
+        fail(403, "M_USER_DEACTIVATED", "This account has been deactivated")
+
+      _ ->
+        :ok
+    end
+  end
+
+  defp q(sql, params), do: Nebu.Repo.query(sql, params)
+
+  # inside a transaction (or a read): a database error aborts with its KIND only (never a message, which can quote row data)
+  defp q!(sql, params) do
+    case Nebu.Repo.query(sql, params) do
+      {:ok, result} -> result
+      {:error, e} -> throw({:db_error, error_kind(e)})
+    end
+  end
+
+  defp fail(status, errcode, message, extra \\ %{}), do: Nebu.Repo.rollback({:api, status, errcode, message, extra})
+
+  defp transact(conn, fun) do
+    result =
+      try do
+        Nebu.Repo.transaction(fn ->
+          try do
+            fun.()
+          catch
+            :throw, {:db_error, kind} -> Nebu.Repo.rollback({:db, kind})
+          end
+        end)
+      rescue
+        e -> {:error, {:db, error_kind(e)}}
+      end
+
+    case result do
+      {:ok, {status, body}} ->
+        send_json(conn, status, body)
+
+      {:error, {:api, _, _, _, _} = err} ->
+        api_error(conn, Tuple.delete_at(err, 0))
+
+      {:error, {:db, kind}} ->
+        Logger.error("room keys write failed: #{kind}")
+        error(conn, 500, "M_UNKNOWN", "The key backup could not be written, please try again.")
+
+      {:error, other} ->
+        Logger.error("room keys write failed: #{error_kind(other)}")
+        error(conn, 500, "M_UNKNOWN", "The key backup could not be written, please try again.")
+    end
+  end
+
+  defp api_error(conn, {status, errcode, message, extra}), do: send_json(conn, status, Map.merge(%{"errcode" => errcode, "error" => message}, extra))
+
+  defp not_found(conn, _version), do: error(conn, 404, "M_NOT_FOUND", "No backup found")
+
+  defp internal(conn, e) do
+    Logger.error("room keys read failed: #{error_kind(e)}")
+    error(conn, 500, "M_UNKNOWN", "The key backup could not be read, please try again.")
+  end
+
+  # a read: a database error answers a generic 500 (kind only in the log)
+  defp guard_read(conn, fun) do
+    fun.()
+  rescue
+    e -> internal(conn, e)
+  catch
+    :throw, {:db_error, _kind} -> internal(conn, :db_error)
+  end
+
+  # the kind of an error for the log: an exception's module or an atom, never its message
+  defp error_kind(%{__struct__: module}), do: inspect(module)
+  defp error_kind(reason) when is_atom(reason), do: Atom.to_string(reason)
+  defp error_kind(_), do: "error"
+end
