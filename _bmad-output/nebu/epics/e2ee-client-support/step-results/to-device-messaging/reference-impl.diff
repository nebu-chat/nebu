diff --git a/server/lib/nebu/matrix/http_to_device.ex b/server/lib/nebu/matrix/http_to_device.ex
new file mode 100644
index 00000000..e7bbc692
--- /dev/null
+++ b/server/lib/nebu/matrix/http_to_device.ex
@@ -0,0 +1,116 @@
+defmodule Nebu.Matrix.HttpToDevice do
+  @moduledoc """
+  HTTP side of `PUT /_matrix/client/v3/sendToDevice/{eventType}/{txnId}` (story to-device-messaging, epic e2ee-client-support): request
+  validation and answers. The route lives in `Nebu.Web.Router.Protected` (authentication, the per-user rate limit, and only then the body is
+  read with the 64 KiB cap, see `Nebu.Web.Plugs.JsonBody.parse_to_device/1`); the queue lives in `Nebu.Matrix.ToDeviceStore`.
+
+  Content is OPAQUE and never logged. An unknown user or device, a user the sender shares no room with, a remote user and a malformed user id
+  are skipped silently: the answer is the same `200 {}` in every case (no existence or membership oracle).
+
+  ## Errors
+
+    * `400 M_NOT_JSON` malformed JSON, `400 M_BAD_JSON` `messages` missing / not an object, an entry that is not an object, a body that is not an object;
+    * `400 M_INVALID_PARAM` an event type outside `^[a-zA-Z0-9._-]{1,255}$`, a txn id of 0 or more than 255 bytes;
+    * `413 M_TOO_LARGE` a body above 64 KiB, more than 50 recipient entries (`*` counts as one);
+    * `429 M_LIMIT_EXCEEDED` the sender's rate limit, or a concurrent identical transaction;
+    * `500 M_UNKNOWN` a failed database operation (generic text).
+  """
+  import Nebu.Matrix.Http, only: [send_json: 3, error: 4]
+  require Logger
+
+  alias Nebu.Matrix.ToDeviceStore, as: Store
+
+  @max_entries 50
+  @max_id_bytes 255
+  @type_regex ~r/\A[a-zA-Z0-9._-]{1,255}\z/
+
+  @spec send_to_device(Plug.Conn.t(), String.t(), String.t()) :: Plug.Conn.t()
+  def send_to_device(conn, event_type, txn_id) do
+    with :ok <- check_json(conn),
+         :ok <- check_type(event_type),
+         :ok <- check_txn(txn_id),
+         {:ok, messages} <- messages(conn),
+         {:ok, entries} <- entries(messages),
+         :ok <- check_count(entries) do
+      sender = conn.assigns[:current_user]
+      device = device_id(conn)
+
+      case Store.send(sender, device, event_type, txn_id, Enum.filter(entries, &storable?/1)) do
+        :ok -> send_json(conn, 200, %{})
+        {:error, busy} when busy in [:lock_timeout, :lock_busy] -> Nebu.Web.Plugs.RateLimit.respond_limited(conn, 1)
+        {:error, :user_erased} -> error(conn, 403, "M_USER_DEACTIVATED", "This account has been deactivated")
+        {:error, reason} -> failed(conn, reason)
+      end
+    else
+      {:error, {status, errcode, message}} -> error(conn, status, errcode, message)
+    end
+  end
+
+  defp device_id(conn) do
+    case conn.assigns[:device_id] do
+      id when is_binary(id) -> id
+      _ -> ""
+    end
+  end
+
+  defp check_json(conn) do
+    if conn.assigns[:json_parse_error] == true, do: {:error, {400, "M_NOT_JSON", "Request body is not valid JSON"}}, else: :ok
+  end
+
+  defp check_type(type) do
+    if is_binary(type) and Regex.match?(@type_regex, type), do: :ok, else: {:error, {400, "M_INVALID_PARAM", "Invalid event type"}}
+  end
+
+  defp check_txn(txn) do
+    if is_binary(txn) and byte_size(txn) in 1..@max_id_bytes and String.valid?(txn) and not String.contains?(txn, <<0>>),
+      do: :ok,
+      else: {:error, {400, "M_INVALID_PARAM", "Invalid transaction id"}}
+  end
+
+  defp messages(conn) do
+    case conn.body_params do
+      %{"messages" => messages} when is_map(messages) -> {:ok, messages}
+      _ -> {:error, {400, "M_BAD_JSON", "Request body must be a JSON object with an object member `messages`"}}
+    end
+  end
+
+  # `[%{user_id, device, content}]`: every user entry must map to an object of device entries, every device entry to an object (the content)
+  defp entries(messages) do
+    Enum.reduce_while(messages, {:ok, []}, fn
+      {user, devices}, {:ok, acc} when is_binary(user) and is_map(devices) ->
+        case Enum.reduce_while(devices, {:ok, []}, fn
+               {device, content}, {:ok, inner} when is_map(content) -> {:cont, {:ok, [%{user_id: user, device: device, content: Jason.encode!(content)} | inner]}}
+               _bad, _ -> {:halt, :bad}
+             end) do
+          {:ok, list} -> {:cont, {:ok, list ++ acc}}
+          :bad -> {:halt, {:error, {400, "M_BAD_JSON", "Every device entry must be a JSON object"}}}
+        end
+
+      _bad, _ ->
+        {:halt, {:error, {400, "M_BAD_JSON", "Every user entry must be a JSON object"}}}
+    end)
+  end
+
+  defp check_count(entries) do
+    if length(entries) > @max_entries,
+      do: {:error, {413, "M_TOO_LARGE", "Too many recipient entries (at most #{@max_entries})"}},
+      else: :ok
+  end
+
+  # an entry that can name no stored row (malformed user id, a device id that is not valid text) is skipped like an unknown recipient
+  defp storable?(%{user_id: user, device: device}) do
+    Nebu.Matrix.UserId.valid?(user) and valid_device?(device)
+  end
+
+  defp valid_device?("*"), do: true
+  defp valid_device?(d), do: byte_size(d) in 1..@max_id_bytes and String.valid?(d) and not String.contains?(d, <<0>>)
+
+  defp failed(conn, reason) do
+    Logger.error("to-device request failed: #{error_kind(reason)}")
+    error(conn, 500, "M_UNKNOWN", "The message could not be queued, please try again.")
+  end
+
+  defp error_kind(%{__struct__: module}), do: inspect(module)
+  defp error_kind(reason) when is_atom(reason), do: Atom.to_string(reason)
+  defp error_kind(_), do: "error"
+end
diff --git a/server/lib/nebu/matrix/to_device_send_gate.ex b/server/lib/nebu/matrix/to_device_send_gate.ex
new file mode 100644
index 00000000..a1367514
--- /dev/null
+++ b/server/lib/nebu/matrix/to_device_send_gate.ex
@@ -0,0 +1,88 @@
+defmodule Nebu.Matrix.ToDeviceSendGate do
+  @moduledoc """
+  The slots of the to-device SENDS (`PUT /sendToDevice/{eventType}/{txnId}`; story to-device-messaging): at most `max_per_user/0` sends in flight per user (default 4,
+  `config :nebu, :to_device_max_concurrent_sends_per_user`) and at most `max_per_node/0` on this node (default 32, `:to_device_max_concurrent_sends_per_node`), both read
+  per admission. A rate limit is not a concurrency limit: this bounds the memory of the bodies being parsed and fanned out and the pooled connections a burst of
+  accounts can occupy at once, and no single user can take the node's slots (cross-user starvation).
+
+  Node-local by design, like the rate tiers (documented: N x the limit in a cluster). A supervised GenServer: a holder is a MONITORED request process, its slot is freed by
+  `run/2` and, when the process is killed in flight, on its `:DOWN`. A sender that finds no slot is refused at once (the caller answers 429 before the body is read).
+  """
+  use GenServer
+
+  @default_per_user 4
+  @default_per_node 32
+
+  def start_link(_opts), do: GenServer.start_link(__MODULE__, :ok, name: __MODULE__)
+
+  @spec max_per_user() :: pos_integer()
+  def max_per_user, do: positive(:to_device_max_concurrent_sends_per_user, @default_per_user)
+
+  @spec max_per_node() :: pos_integer()
+  def max_per_node, do: positive(:to_device_max_concurrent_sends_per_node, @default_per_node)
+
+  defp positive(key, default) do
+    case Application.get_env(:nebu, key, default) do
+      n when is_integer(n) and n > 0 -> n
+      _ -> default
+    end
+  end
+
+  @doc "Runs `fun` in the calling process while a slot of `user_id` is held: `{:ok, result}` or `:overflow`."
+  @spec run(String.t() | nil, (-> result)) :: {:ok, result} | :overflow when result: term()
+  def run(user_id, fun) when is_function(fun, 0) do
+    case acquire(user_id) do
+      {:ok, slot} ->
+        try do
+          {:ok, fun.()}
+        after
+          GenServer.cast(__MODULE__, {:release, slot})
+        end
+
+      :overflow ->
+        :overflow
+    end
+  end
+
+  defp acquire(user_id) do
+    GenServer.call(__MODULE__, {:acquire, user_id, self(), max_per_user(), max_per_node()}, 5_000)
+  catch
+    :exit, {:timeout, _} ->
+      GenServer.cast(__MODULE__, {:cancel, self()})
+      :overflow
+
+    :exit, _reason ->
+      :overflow
+  end
+
+  @impl GenServer
+  def init(:ok), do: {:ok, %{holders: %{}}}
+
+  @impl GenServer
+  def handle_call({:acquire, user_id, pid, per_user, per_node}, _from, state) do
+    user_count = Enum.count(state.holders, fn {_slot, {user, _pid}} -> user == user_id end)
+
+    if user_count >= per_user or map_size(state.holders) >= per_node do
+      {:reply, :overflow, state}
+    else
+      slot = Process.monitor(pid)
+      {:reply, {:ok, slot}, %{state | holders: Map.put(state.holders, slot, {user_id, pid})}}
+    end
+  end
+
+  @impl GenServer
+  def handle_cast({:release, slot}, state) do
+    Process.demonitor(slot, [:flush])
+    {:noreply, %{state | holders: Map.delete(state.holders, slot)}}
+  end
+
+  def handle_cast({:cancel, pid}, state) do
+    {gone, kept} = Enum.split_with(state.holders, fn {_slot, {_user, holder}} -> holder == pid end)
+    Enum.each(gone, fn {slot, _holder} -> Process.demonitor(slot, [:flush]) end)
+    {:noreply, %{state | holders: Map.new(kept)}}
+  end
+
+  @impl GenServer
+  def handle_info({:DOWN, slot, :process, _pid, _reason}, state), do: {:noreply, %{state | holders: Map.delete(state.holders, slot)}}
+  def handle_info(_other, state), do: {:noreply, state}
+end
diff --git a/server/lib/nebu/matrix/to_device_store.ex b/server/lib/nebu/matrix/to_device_store.ex
new file mode 100644
index 00000000..ecdca401
--- /dev/null
+++ b/server/lib/nebu/matrix/to_device_store.ex
@@ -0,0 +1,470 @@
+defmodule Nebu.Matrix.ToDeviceStore do
+  @moduledoc """
+  The to-device queue (story to-device-messaging, epic e2ee-client-support, REQ-2026-012): Matrix CS v1.18 "Send-to-Device messaging".
+
+  Transport only. The content of a message is OPAQUE (never parsed beyond JSON well-formedness, never logged: a failing statement
+  logs the KIND of its error only, a Postgrex message can quote row data). ADR-011 stays: this enables no E2EE room. No federation.
+
+  State lives only in PostgreSQL (`to_device_messages`, `to_device_txns`, migration 000059): the queue, the idempotency records and the
+  acknowledgement position are cluster-safe, a restart or another node sees the same state (ADR-020). SQL is inline (ADR-018).
+
+  ## Delivery and acknowledgement
+
+  A message is delivered by `/sync` and deleted only when a LATER sync presents the token of the response that carried it:
+
+    * the first response that carries a message stamps it with `delivery_seq` (the next value of `to_device_delivery_seq`, one value per
+      response); the position of the response token is the highest `delivery_seq` it carries;
+    * a sync that presents a token with position `p` deletes the messages with `delivery_seq <= p` (acknowledged) and delivers the messages
+      with `delivery_seq IS NULL OR delivery_seq > p`: a retry with an older token delivers a batch again, never loses it;
+    * a message that committed late (a lower `stream_pos` than a delivered one) has no `delivery_seq` yet, so no acknowledgement can delete it.
+
+  ## Budgets (every per-item cap has an aggregate cap; all seams are read at request time, defaults in `limits/0`)
+
+  Per device 500 messages / 8 MiB, per user 2000 messages / 32 MiB, per sender and device 100 messages, 100 targets and 1 MiB of rows per request, 1000
+  idempotency records per device, 100 messages / 1 MiB per sync response. A full queue evicts its OLDEST messages (the sender is never told;
+  the count is logged without content). The row cost of the byte budgets is the content bytes plus 128.
+
+  ## No waiting locks
+
+  The transaction of a send and of a delivery runs with a short `lock_timeout`: a statement that would wait for a row lock is
+  `{:error, :lock_timeout}` (answered 429 / 503), no waiter holds a pooled connection. The purge uses `FOR UPDATE SKIP LOCKED`.
+  """
+  require Logger
+
+  @row_overhead 128
+  @lock_timeout_ms 100
+
+  @defaults %{
+    max_per_device: 500,
+    max_bytes_per_device: 8 * 1024 * 1024,
+    max_per_user: 2000,
+    max_bytes_per_user: 32 * 1024 * 1024,
+    max_per_sender_device: 100,
+    max_per_sender_user: 200,
+    max_bytes_per_sender_user: 4 * 1024 * 1024,
+    max_targets_per_request: 100,
+    max_fanout_bytes_per_request: 1024 * 1024,
+    max_txns_per_device: 1000,
+    sync_batch_size: 100,
+    sync_batch_bytes: 1024 * 1024,
+    ttl_seconds: 7 * 24 * 3600,
+    txn_ttl_seconds: 24 * 3600
+  }
+
+  @doc "The effective limits (defaults merged with the `:nebu, :to_device_<name>` seams)."
+  @spec limits() :: map()
+  def limits do
+    Map.new(@defaults, fn {key, default} ->
+      value = Application.get_env(:nebu, String.to_atom("to_device_#{key}"), default)
+      {key, if(is_integer(value) and value > 0, do: value, else: default)}
+    end)
+  end
+
+  @doc "The fixed byte cost of a queued row on top of its content bytes."
+  def row_overhead, do: @row_overhead
+
+  # ── send ─────────────────────────────────────────────────────────────────────
+
+  @doc """
+  Queues the messages of one `sendToDevice` request: `entries` is `[%{user_id, device, content}]` (`device` an id or `"*"`, `content` the
+  canonical JSON text). Idempotent per (sender, sender device, event type, txn id). Recipients are the sender's own devices and the
+  devices of users who share a room with the sender (either side `join` or `invite`, evaluated now); everything else is skipped silently.
+  `:ok | {:error, :lock_timeout | :lock_busy | :user_erased | term}`.
+  """
+  @spec send(String.t(), String.t(), String.t(), String.t(), [map()]) :: :ok | {:error, term()}
+  def send(sender, sender_device, event_type, txn_id, entries) do
+    result =
+      transact(fn ->
+        with {:ok, _} <- query("SELECT set_config('lock_timeout', $1::text, true)", ["#{@lock_timeout_ms}ms"]),
+             :ok <- lock_sender(sender),
+             {:ok, fresh?} <- record_txn(sender, sender_device, event_type, txn_id) do
+          if fresh?, do: enqueue(sender, sender_device, event_type, entries), else: {:ok, []}
+        end
+      end)
+
+    case result do
+      {:ok, targets} ->
+        wake(targets)
+        :ok
+
+      {:error, reason} ->
+        {:error, reason}
+    end
+  end
+
+  # the GDPR erasure takes the per-user `sync_global` advisory lock EXCLUSIVELY (the same key as the account data and the key backup writers); a send takes it
+  # SHARED and only as a TRY-lock (no waiter holds a connection): a sender whose own erasure is under way is answered 429 at once, and a send never re-creates
+  # rows (as sender or as recipient) after the erasure deleted them: the status is read AFTER the lock
+  defp lock_sender(sender) do
+    with {:ok, %{rows: [[locked?]]}} <- query("SELECT pg_try_advisory_xact_lock_shared(hashtextextended('sync_global|' || $1::text, 0))", [sender]) do
+      if locked?, do: ensure_not_erased(sender), else: {:error, :lock_busy}
+    end
+  end
+
+  defp ensure_not_erased(user) do
+    case query("SELECT 1 FROM users WHERE user_id = $1 AND deletion_status IS NOT NULL", [user]) do
+      {:ok, %{rows: []}} -> :ok
+      {:ok, _} -> {:error, :user_erased}
+      {:error, _} = err -> err
+    end
+  end
+
+  defp record_txn(sender, sender_device, event_type, txn_id) do
+    limits = limits()
+
+    with {:ok, %{num_rows: n}} <-
+           query(
+             "INSERT INTO to_device_txns (user_id, device_id, event_type, txn_id) VALUES ($1, $2, $3, $4) ON CONFLICT DO NOTHING",
+             [sender, sender_device, event_type, txn_id]
+           ),
+         {:ok, _} <-
+           (if n == 1 do
+              query(
+                """
+                DELETE FROM to_device_txns WHERE user_id = $1 AND device_id = $2 AND ctid IN
+                  (SELECT ctid FROM to_device_txns WHERE user_id = $1 AND device_id = $2 ORDER BY created_at DESC, txn_id OFFSET $3)
+                """,
+                [sender, sender_device, limits.max_txns_per_device]
+              )
+            else
+              {:ok, nil}
+            end) do
+      {:ok, n == 1}
+    end
+  end
+
+  # The SAME statements run whatever the outcome (an unknown, unshared or deactivated recipient only makes the arrays empty): the work of a request does not tell
+  # a delivered recipient from a skipped one (no timing oracle; pinned by counting the statements).
+  defp enqueue(sender, sender_device, event_type, entries) do
+    users = entries |> Enum.map(& &1.user_id) |> Enum.uniq()
+
+    with {:ok, allowed} <- allowed_users(sender, users),
+         {:ok, targets} <- resolve_targets(sender, sender_device, Enum.filter(entries, &MapSet.member?(allowed, &1.user_id))) do
+      {us, ds, cs} = {Enum.map(targets, &elem(&1, 0)), Enum.map(targets, &elem(&1, 1)), Enum.map(targets, &elem(&1, 2))}
+
+      with {:ok, _} <-
+             query(
+               """
+               INSERT INTO to_device_messages (user_id, device_id, sender, event_type, content, bytes)
+               SELECT t.u, t.d, $1, $2, t.c, octet_length(t.c) FROM unnest($3::text[], $4::text[], $5::text[]) AS t(u, d, c)
+               """,
+               [sender, event_type, us, ds, cs]
+             ),
+           {:ok, evicted} <- evict(sender, us, ds) do
+        if evicted > 0, do: Logger.info("to-device: evicted #{evicted} message(s) from full queues")
+        {:ok, Enum.map(targets, fn {u, d, _c} -> {u, d} end)}
+      end
+    end
+  end
+
+  # the sender itself, plus every user who shares a room with the sender where BOTH sides are `join` (an invitation opens no send path: no consent, and in-room
+  # verification does not use to-device messages); the statement runs even when there is no other user
+  defp allowed_users(sender, users) do
+    others = users -- [sender]
+
+    with {:ok, %{rows: rows}} <-
+           query(
+             """
+             SELECT DISTINCT o.user_id FROM room_members o JOIN room_members m ON m.room_id = o.room_id
+             WHERE o.user_id = ANY($2::text[]) AND o.left_at IS NULL AND m.user_id = $1 AND m.left_at IS NULL
+             """,
+             [sender, others]
+           ),
+         {:ok, active} <- active_users(List.flatten(rows)) do
+      {:ok, MapSet.new(if(sender in users, do: [sender | active], else: active))}
+    end
+  end
+
+  # a deactivated (or erased) user receives nothing new: its queue is kept (a deactivation is reversible) but not extended
+  # (a recipient whose erasure holds its lock is skipped like an unknown one: no oracle, and no row is created behind the erasure)
+  defp active_users(users) do
+    with {:ok, %{rows: rows}} <-
+           query(
+             """
+             SELECT u.user_id FROM users u WHERE u.user_id = ANY($1::text[]) AND u.is_active AND u.deletion_status IS NULL
+               AND pg_try_advisory_xact_lock_shared(hashtextextended('sync_global|' || u.user_id, 0))
+             """,
+             [users]
+           ) do
+      {:ok, List.flatten(rows)}
+    end
+  end
+
+  # `[{user, device, content}]`: an explicit device entry wins over `*`, `*` of the sender excludes the sending device, only existing devices
+  # (a `devices` row), at most `max_targets_per_request` in total
+  defp resolve_targets(sender, sender_device, entries) do
+    cap = limits().max_targets_per_request
+    explicit = for %{device: d} = e <- entries, d != "*", do: e
+    stars = for %{device: "*"} = e <- entries, do: e
+
+    with {:ok, existing} <- existing_devices(explicit),
+         {:ok, expanded} <- star_devices(stars, cap) do
+      star_targets =
+        for {user, device} <- expanded,
+            not (user == sender and device == sender_device),
+            do: {user, device, star_content(stars, user)}
+
+      explicit_targets = for %{user_id: u, device: d, content: c} <- explicit, MapSet.member?(existing, {u, d}), do: {u, d, c}
+      explicit_keys = MapSet.new(explicit_targets, fn {u, d, _} -> {u, d} end)
+
+      merged = explicit_targets ++ Enum.reject(star_targets, fn {u, d, _} -> MapSet.member?(explicit_keys, {u, d}) end)
+      {:ok, merged |> Enum.uniq_by(fn {u, d, _} -> {u, d} end) |> Enum.take(cap) |> fit_fanout_bytes(limits().max_fanout_bytes_per_request)}
+    end
+  end
+
+  # the rows of ONE request cost at most `max_fanout_bytes_per_request` (content + 128 per row, deterministic order, the first target is always kept): a 64 KiB content
+  # cannot fan out to 100 devices (6.4 MB of parameters and rows per request); beyond the budget the targets are dropped silently like an unreachable one
+  defp fit_fanout_bytes(targets, budget) do
+    {kept, _} =
+      Enum.reduce_while(targets, {[], 0}, fn {_u, _d, content} = target, {acc, total} ->
+        cost = byte_size(content) + @row_overhead
+        if acc != [] and total + cost > budget, do: {:halt, {acc, total}}, else: {:cont, {[target | acc], total + cost}}
+      end)
+
+    Enum.reverse(kept)
+  end
+
+  defp star_content(stars, user), do: stars |> Enum.find(&(&1.user_id == user)) |> Map.fetch!(:content)
+
+  defp existing_devices(explicit) do
+    with {:ok, %{rows: rows}} <-
+           query(
+             "SELECT user_id, device_id FROM devices WHERE (user_id, device_id) IN (SELECT * FROM unnest($1::text[], $2::text[]))",
+             [Enum.map(explicit, & &1.user_id), Enum.map(explicit, & &1.device)]
+           ) do
+      {:ok, MapSet.new(rows, fn [u, d] -> {u, d} end)}
+    end
+  end
+
+  defp star_devices(stars, cap) do
+    with {:ok, %{rows: rows}} <-
+           query(
+             """
+             SELECT u.user_id, d.device_id FROM unnest($1::text[]) AS u(user_id)
+             CROSS JOIN LATERAL (SELECT device_id FROM devices WHERE user_id = u.user_id ORDER BY COALESCE(last_seen_ts, 0) DESC, device_id LIMIT $2) d
+             """,
+             [stars |> Enum.map(& &1.user_id) |> Enum.uniq(), cap]
+           ) do
+      {:ok, Enum.map(rows, fn [u, d] -> {u, d} end)}
+    end
+  end
+
+  # the budgets of the touched queues, set based (a constant number of statements however many recipients): (1) the sender's share of a device queue, (2) the sender's
+  # share of a recipient USER's queues (200 messages / 4 MiB: its own oldest go first), (3) the device queue (count and bytes, oldest first), (4) the recipient user
+  # (count and bytes) EVICTED FAIRLY: the oldest message of the sender with the LARGEST share goes first (a row's rank is its position counted from the newest message
+  # of its sender; the highest ranks go first, older first on a tie), so a flooding co-member never evicts the older messages of a sender below its share.
+  # Returns the number of evicted rows.
+  defp evict(sender, us, ds) do
+    l = limits()
+    users = Enum.uniq(us)
+
+    statements = [
+      {"""
+       DELETE FROM to_device_messages WHERE stream_pos IN (SELECT stream_pos FROM (
+         SELECT stream_pos, row_number() OVER (PARTITION BY user_id, device_id ORDER BY stream_pos DESC) AS rn
+         FROM to_device_messages WHERE sender = $1 AND (user_id, device_id) IN (SELECT * FROM unnest($2::text[], $3::text[]))) s WHERE rn > $4)
+       """, [sender, us, ds, l.max_per_sender_device]},
+      {"""
+       DELETE FROM to_device_messages WHERE stream_pos IN (SELECT stream_pos FROM (
+         SELECT stream_pos, row_number() OVER w AS rn, sum(bytes + $4) OVER w AS total
+         FROM to_device_messages WHERE sender = $1 AND user_id = ANY($2::text[])
+         WINDOW w AS (PARTITION BY user_id ORDER BY stream_pos DESC)) s WHERE rn > $3 OR total > $5)
+       """, [sender, users, l.max_per_sender_user, @row_overhead, l.max_bytes_per_sender_user]},
+      {"""
+       DELETE FROM to_device_messages WHERE stream_pos IN (SELECT stream_pos FROM (
+         SELECT stream_pos, row_number() OVER w AS rn, sum(bytes + $4) OVER w AS total
+         FROM to_device_messages WHERE (user_id, device_id) IN (SELECT * FROM unnest($1::text[], $2::text[]))
+         WINDOW w AS (PARTITION BY user_id, device_id ORDER BY stream_pos DESC)) s WHERE rn > $3 OR total > $5)
+       """, [us, ds, l.max_per_device, @row_overhead, l.max_bytes_per_device]},
+      {fair_user_count_sql(), [users, l.max_per_user]},
+      {fair_user_bytes_sql(), [users, l.max_bytes_per_user, @row_overhead]}
+    ]
+
+    Enum.reduce_while(statements, {:ok, 0}, fn {sql, params}, {:ok, acc} ->
+      case query(sql, params) do
+        {:ok, %{num_rows: n}} -> {:cont, {:ok, acc + n}}
+        {:error, _} = err -> {:halt, err}
+      end
+    end)
+  end
+
+  # the rows of a user beyond the message cap: the rows of the highest rank (largest share) first, the older first on a tie; the first `total - cap` of that order go
+  defp fair_user_count_sql do
+    """
+    DELETE FROM to_device_messages WHERE stream_pos IN (SELECT stream_pos FROM (
+      SELECT stream_pos, row_number() OVER (PARTITION BY user_id ORDER BY rank DESC, stream_pos ASC) AS ord, count(*) OVER (PARTITION BY user_id) AS n
+      FROM (SELECT stream_pos, user_id, row_number() OVER (PARTITION BY user_id, sender ORDER BY stream_pos DESC) AS rank
+            FROM to_device_messages WHERE user_id = ANY($1::text[])) r) s WHERE ord <= n - $2)
+    """
+  end
+
+  # the same for the byte budget (a row costs `bytes + overhead`): the rows are taken in the fair order while the bytes still above the budget are not freed
+  defp fair_user_bytes_sql do
+    """
+    DELETE FROM to_device_messages WHERE stream_pos IN (SELECT stream_pos FROM (
+      SELECT stream_pos, sum(cost) OVER (PARTITION BY user_id ORDER BY rank DESC, stream_pos ASC) - cost AS before, sum(cost) OVER (PARTITION BY user_id) - $2::bigint AS excess
+      FROM (SELECT stream_pos, user_id, bytes + $3 AS cost, row_number() OVER (PARTITION BY user_id, sender ORDER BY stream_pos DESC) AS rank
+            FROM to_device_messages WHERE user_id = ANY($1::text[])) r) s WHERE excess > 0 AND before < excess)
+    """
+  end
+
+  # after the commit: wake the long-polling /sync of exactly the target devices (cluster wide, `:pg`)
+  defp wake(targets) do
+    targets
+    |> Enum.uniq()
+    |> Enum.each(fn {user, device} -> for pid <- :pg.get_members("user:#{user}"), do: Kernel.send(pid, {:to_device, device}) end)
+  end
+
+  # ── delivery ─────────────────────────────────────────────────────────────────
+
+  @doc """
+  Acknowledges and delivers for one /sync: `ack` is the to-device position of the token the client presented (`nil`: an initial or fallback
+  sync, nothing is acknowledged and every pending message is delivered). Returns `{:ok, %{events, position}}` or `{:error, reason}`.
+  """
+  @spec deliver(String.t(), String.t(), non_neg_integer() | nil) :: {:ok, %{events: [map()], position: non_neg_integer()}} | {:error, term()}
+  def deliver(_user, "", _ack), do: {:ok, %{events: [], position: 0}}
+
+  def deliver(user, device, ack) do
+    l = limits()
+    since = ack || 0
+
+    result =
+      transact(fn ->
+        with {:ok, _} <- query("SELECT set_config('lock_timeout', $1::text, true)", ["#{@lock_timeout_ms}ms"]),
+             {:ok, _} <- acknowledge(user, device, ack),
+             {:ok, %{rows: rows}} <-
+               query(
+                 """
+                 SELECT stream_pos, sender, event_type, content, bytes, delivery_seq FROM to_device_messages
+                 WHERE user_id = $1 AND device_id = $2 AND created_at > now() - make_interval(secs => $3) AND (delivery_seq IS NULL OR delivery_seq > $4)
+                 ORDER BY stream_pos LIMIT $5
+                 """,
+                 [user, device, l.ttl_seconds * 1.0, since, l.sync_batch_size]
+               ) do
+          batch = take_within_bytes(rows, l.sync_batch_bytes)
+          stamp(batch, since)
+        end
+      end)
+
+    case result do
+      {:ok, {events, position}} -> {:ok, %{events: events, position: position}}
+      {:error, reason} -> {:error, reason}
+    end
+  end
