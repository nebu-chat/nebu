diff --git a/server/lib/nebu/matrix/device_list_store.ex b/server/lib/nebu/matrix/device_list_store.ex
new file mode 100644
index 00000000..0e409703
--- /dev/null
+++ b/server/lib/nebu/matrix/device_list_store.ex
@@ -0,0 +1,207 @@
+defmodule Nebu.Matrix.DeviceListStore do
+  @moduledoc """
+  The device-list change STREAM (story device-key-directory, epic e2ee-client-support, REQ-2026-013): what `GET /keys/changes` and the `device_lists` of
+  `GET /sync` read. Directory metadata only; ADR-011 stays (this enables no E2EE room). Plain module, inline SQL (ADR-018), PostgreSQL only (cluster safe,
+  ADR-020): no process state.
+
+  ## The table (migration 000060)
+
+  `device_list_changes (user_id, room_id, kind, pos)`, the LATEST change per (user, room): kind `keys` (room_id `''`: the user's device identity keys, device
+  list or cross-signing keys changed; written by `stamp_keys/2`), kind `join` / `leave` (the user's membership of the room changed; written by a trigger on
+  `room_members`). `pos` is drawn from `sync_global_pos_seq` AT COMMIT by a deferred constraint trigger under ONE global advisory lock, so the visible positions
+  are commit ordered: a reader that has seen position M never later sees a row at or below M. `position/0` takes the same lock for an instant, so the
+  position it returns is above every position that is visible now.
+
+  ## The token position
+
+  The position travels in the sync `next_batch` as an optional LAST group `.d<digits>` (`strip_position/1`, `put_position/2`). A token without it means
+  "unknown" (`nil`): the readers answer conservatively with every user the caller currently shares a joined room with.
+
+  ## Who is reported
+
+  Always through the caller's OWN shared rooms (both sides `join`): `changed` = users (and the caller itself) whose keys changed after `since`, users who joined
+  a room the caller is in after `since`, and, when the caller joined a room after `since`, every other member of it; `left` = users who share no joined room
+  with the caller any more although a `leave` was stamped after `since` in a room both were in (it can over-report a user who shared a room only at another
+  time; it never under-reports a real loss).
+  """
+
+  @lock_class 4760
+  @lock_obj 60
+  @max_pos 9_223_372_036_854_775_807
+  @token_re ~r/\A[A-Za-z0-9_\-=]{1,256}(\.[0-9]{1,19}){0,2}(\.d[0-9]{1,19})?\z/
+
+  @changed_sql """
+  WITH me AS MATERIALIZED (SELECT room_id FROM room_members WHERE user_id = $1 AND left_at IS NULL),
+       shared AS MATERIALIZED (
+         SELECT DISTINCT o.user_id FROM room_members o JOIN me ON me.room_id = o.room_id WHERE o.left_at IS NULL AND o.user_id <> $1),
+       hits AS (
+         SELECT c.user_id, c.pos FROM device_list_changes c
+          WHERE c.kind = 'keys' AND c.pos > $2 AND ($3::bigint IS NULL OR c.pos <= $3)
+            AND (c.user_id = $1 OR c.user_id IN (SELECT user_id FROM shared))
+         UNION ALL
+         SELECT c.user_id, c.pos FROM device_list_changes c JOIN me ON me.room_id = c.room_id
+          WHERE c.kind = 'join' AND c.user_id <> $1 AND c.pos > $2 AND ($3::bigint IS NULL OR c.pos <= $3)
+         UNION ALL
+         SELECT m.user_id, c.pos FROM device_list_changes c
+           JOIN me ON me.room_id = c.room_id
+           JOIN room_members m ON m.room_id = c.room_id AND m.left_at IS NULL AND m.user_id <> $1
+          WHERE c.user_id = $1 AND c.kind = 'join' AND c.pos > $2 AND ($3::bigint IS NULL OR c.pos <= $3))
+  SELECT user_id, max(pos) FROM hits GROUP BY user_id ORDER BY user_id
+  """
+
+  @left_sql """
+  WITH hits AS (
+         SELECT c.user_id, c.pos FROM device_list_changes c
+          WHERE c.kind = 'leave' AND c.user_id <> $1 AND c.pos > $2 AND ($3::bigint IS NULL OR c.pos <= $3)
+            AND EXISTS (SELECT 1 FROM room_members m WHERE m.room_id = c.room_id AND m.user_id = $1)
+         UNION ALL
+         SELECT m.user_id, c.pos FROM device_list_changes c
+           JOIN room_members m ON m.room_id = c.room_id AND m.user_id <> $1
+          WHERE c.user_id = $1 AND c.kind = 'leave' AND c.pos > $2 AND ($3::bigint IS NULL OR c.pos <= $3))
+  SELECT h.user_id, max(h.pos) FROM hits h
+   WHERE NOT EXISTS (SELECT 1 FROM room_members a JOIN room_members b ON b.room_id = a.room_id
+                      WHERE a.user_id = h.user_id AND a.left_at IS NULL AND b.user_id = $1 AND b.left_at IS NULL)
+   GROUP BY h.user_id ORDER BY h.user_id
+  """
+
+  # ── the token ────────────────────────────────────────────────────────────────
+
+  @doc """
+  Splits the device-list position off a sync token: `{token_without_group, position | nil}`. A group that is not `.d<digits>` or whose number does not fit
+  an int8 leaves the token as it is with `nil`.
+  """
+  @spec strip_position(String.t() | nil) :: {String.t() | nil, non_neg_integer() | nil}
+  def strip_position(token) when is_binary(token) do
+    case Regex.run(~r/\A(.+)\.d([0-9]+)\z/s, token) do
+      [_, rest, digits] -> {rest, to_pos(digits)}
+      _ -> {token, nil}
+    end
+  end
+
+  def strip_position(other), do: {other, nil}
+
+  @doc "Appends the position group (`nil` appends nothing)."
+  @spec put_position(String.t(), non_neg_integer() | nil) :: String.t()
+  def put_position(token, nil), do: token
+  def put_position(token, pos) when is_integer(pos), do: token <> ".d" <> Integer.to_string(pos)
+
+  @doc """
+  Validates a token for `GET /keys/changes`: `{:ok, position | nil}` (nil: well formed, no device-list position) or `:error` (malformed: outside the token
+  alphabet, a bad group, longer than 512 bytes, a number that does not fit an int8).
+  """
+  @spec parse_token(term()) :: {:ok, non_neg_integer() | nil} | :error
+  def parse_token(token) when is_binary(token) and byte_size(token) in 1..512 do
+    if Regex.match?(@token_re, token) do
+      case Regex.run(~r/\.d([0-9]+)\z/, token) do
+        [_, digits] -> if to_pos(digits), do: {:ok, to_pos(digits)}, else: :error
+        _ -> {:ok, nil}
+      end
+    else
+      :error
+    end
+  end
+
+  def parse_token(_), do: :error
+
+  defp to_pos(digits) do
+    pos = if byte_size(digits) <= 19, do: String.to_integer(digits)
+    if is_integer(pos) and pos <= @max_pos, do: pos
+  end
+
+  # ── writing ──────────────────────────────────────────────────────────────────
+
+  @doc """
+  Marks the user's device list as changed (keys / devices / cross-signing). The position is drawn at the COMMIT of the surrounding transaction; run it inside
+  the transaction of the write it belongs to (`repo` is the repo of that transaction). Raises on a database error so the write rolls back with it.
+  """
+  @spec stamp_keys!(module(), String.t()) :: :ok
+  def stamp_keys!(repo \\ Nebu.Repo, user_id) when is_binary(user_id) do
+    case Ecto.Adapters.SQL.query(
+           repo,
+           """
+           INSERT INTO device_list_changes (user_id, room_id, kind, pos) VALUES ($1, '', 'keys', NULL)
+           ON CONFLICT (user_id, room_id) DO UPDATE SET kind = 'keys', pos = NULL
+           """,
+           [user_id]
+         ) do
+      {:ok, _} -> :ok
+      {:error, error} -> raise error
+    end
+  end
+
+  # ── reading ──────────────────────────────────────────────────────────────────
+
+  @doc """
+  A fresh position that is above every position visible now (a short transaction that takes the commit lock, then draws the next value). `{:ok, pos}` or
+  `{:error, reason}`; never raises.
+  """
+  @spec position() :: {:ok, non_neg_integer()} | {:error, term()}
+  def position do
+    if Process.whereis(Nebu.Repo) do
+      case Nebu.Repo.transaction(fn ->
+             Ecto.Adapters.SQL.query!(Nebu.Repo, "SELECT pg_advisory_xact_lock($1, $2)", [@lock_class, @lock_obj])
+             %{rows: [[pos]]} = Ecto.Adapters.SQL.query!(Nebu.Repo, "SELECT nextval('sync_global_pos_seq')", [])
+             pos
+           end) do
+        {:ok, pos} -> {:ok, pos}
+        {:error, reason} -> {:error, reason}
+      end
+    else
+      {:error, :repo_not_started}
+    end
+  rescue
+    e -> {:error, e}
+  catch
+    :exit, reason -> {:error, reason}
+  end
+
+  @doc """
+  The users to report to `user_id` between `since` (exclusive, a position; `nil` = unknown: everyone currently shared) and `upto` (inclusive, `nil` = no
+  bound): `{:ok, %{changed: [user], left: [user], pos: position}}` where `pos` is the highest position among the reported rows (else `since`). Never raises.
+  """
+  @spec changes(String.t(), non_neg_integer() | nil, non_neg_integer() | nil) ::
+          {:ok, %{changed: [String.t()], left: [String.t()], pos: non_neg_integer() | nil}} | {:error, term()}
+  def changes(user_id, nil, _upto) do
+    with {:ok, shared} <- shared_users(user_id), do: {:ok, %{changed: Enum.uniq([user_id | shared]), left: [], pos: nil}}
+  end
+
+  def changes(user_id, since, upto) when is_integer(since) do
+    if Process.whereis(Nebu.Repo) do
+      with {:ok, %{rows: changed}} <- query(@changed_sql, [user_id, since, upto]),
+           {:ok, %{rows: left}} <- query(@left_sql, [user_id, since, upto]) do
+        pos = (changed ++ left) |> Enum.map(fn [_u, p] -> p end) |> Enum.max(fn -> since end)
+        {:ok, %{changed: Enum.map(changed, &hd/1), left: Enum.map(left, &hd/1), pos: pos}}
+      end
+    else
+      {:error, :repo_not_started}
+    end
+  rescue
+    e -> {:error, e}
+  catch
+    :exit, reason -> {:error, reason}
+  end
+
+  @doc "Every other user the caller currently shares a joined room with (both sides `join`)."
+  @spec shared_users(String.t()) :: {:ok, [String.t()]} | {:error, term()}
+  def shared_users(user_id) do
+    if Process.whereis(Nebu.Repo) do
+      with {:ok, %{rows: rows}} <-
+             query(
+               """
+               SELECT DISTINCT o.user_id FROM room_members o JOIN room_members m ON m.room_id = o.room_id
+                WHERE m.user_id = $1 AND m.left_at IS NULL AND o.left_at IS NULL AND o.user_id <> $1
+               """,
+               [user_id]
+             ),
+           do: {:ok, List.flatten(rows)}
+    else
+      {:error, :repo_not_started}
+    end
+  rescue
+    e -> {:error, e}
+  catch
+    :exit, reason -> {:error, reason}
+  end
+
+  defp query(sql, params), do: Ecto.Adapters.SQL.query(Nebu.Repo, sql, params)
+end
diff --git a/server/lib/nebu/matrix/http_key_directory.ex b/server/lib/nebu/matrix/http_key_directory.ex
new file mode 100644
index 00000000..5eb034b1
--- /dev/null
+++ b/server/lib/nebu/matrix/http_key_directory.ex
@@ -0,0 +1,143 @@
+defmodule Nebu.Matrix.HttpKeyDirectory do
+  @moduledoc """
+  HTTP side of `POST /_matrix/client/v3/keys/claim` and `GET /_matrix/client/v3/keys/changes` (story device-key-directory, epic e2ee-client-support,
+  REQ-2026-013). The routes live in `Nebu.Web.Router.Protected` (authentication first); the stores are `Nebu.Matrix.KeyClaimStore` and
+  `Nebu.Matrix.DeviceListStore`. Key material is never logged (law: no sensitive data in logs).
+
+  ## Claim
+
+    * `400 M_NOT_JSON` malformed JSON; `400 M_BAD_JSON` `one_time_keys` missing / not an object, an entry that is not an object, an algorithm that is not a string;
+      `400 M_INVALID_PARAM` more than 1000 targets (before any bucket is charged);
+    * `429 M_LIMIT_EXCEEDED` a rate bucket of the request is empty (all buckets are checked all-or-nothing BEFORE the consuming statement);
+    * `200 {"one_time_keys": ..., "failures": {}}`: every target that yielded no key (unknown, keyless, not shared, remote, malformed id) is LEFT OUT, `failures` is
+      always empty (the spec keys it by server name, Nebu has no federation).
+
+  The buckets (node-local like every rate tier: N x the limit in a cluster): per caller 30 / min, burst 10 (counts requests); per (caller, target user, target
+  device) 10 / hour, burst 5, charged for EVERY syntactically valid target whatever its state (a 429 that depends on the target would be an existence oracle).
+
+  ## Changes
+
+  `from` and `to` are sync tokens: `400 M_MISSING_PARAM` when one is missing or empty, `400 M_INVALID_PARAM` when one is malformed. A well-formed token without a
+  device-list position ("expired") answers conservatively (every shared user is `changed`).
+  """
+  import Nebu.Matrix.Http, only: [send_json: 3, error: 4]
+  require Logger
+
+  alias Nebu.Matrix.{DeviceListStore, KeyClaimStore}
+
+  @max_targets 1000
+  @max_id_bytes 255
+  @user_per_min 30
+  @user_burst 10
+  @target_per_min 10 / 60
+  @target_burst 5
+
+  @doc "The pinned limits (the tests and the docs read these numbers)."
+  def limits, do: %{max_targets: @max_targets, user_per_min: @user_per_min, user_burst: @user_burst, target_per_hour: 10, target_burst: @target_burst}
+
+  @spec claim(Plug.Conn.t()) :: Plug.Conn.t()
+  def claim(conn) do
+    user = conn.assigns[:current_user]
+
+    with :ok <- check_json(conn),
+         {:ok, targets} <- targets(conn.body_params),
+         :ok <- check_cap(targets),
+         valid = Enum.filter(targets, &valid_target?/1),
+         :ok <- charge(user, valid) do
+      case KeyClaimStore.claim(user, valid) do
+        {:ok, keys} ->
+          send_json(conn, 200, %{"one_time_keys" => keys, "failures" => %{}})
+
+        {:error, reason} ->
+          Logger.error("keys/claim: the claim failed (#{error_kind(reason)})")
+          error(conn, 500, "M_UNKNOWN", "Internal error")
+      end
+    else
+      {:error, {:limited, seconds}} -> Nebu.Web.Plugs.RateLimit.respond_limited(conn, seconds)
+      {:error, {status, errcode, message}} -> error(conn, status, errcode, message)
+    end
+  end
+
+  @spec changes(Plug.Conn.t()) :: Plug.Conn.t()
+  def changes(conn) do
+    user = conn.assigns[:current_user]
+    q = conn.query_params
+
+    with {:ok, from} <- token(q["from"], "from"),
+         {:ok, to} <- token(q["to"], "to") do
+      case DeviceListStore.changes(user, from, if(from == nil, do: nil, else: to)) do
+        {:ok, %{changed: changed, left: left}} ->
+          send_json(conn, 200, %{"changed" => changed, "left" => left})
+
+        {:error, reason} ->
+          Logger.error("keys/changes: the read failed (#{error_kind(reason)})")
+          error(conn, 500, "M_UNKNOWN", "Internal error")
+      end
+    else
+      {:error, {status, errcode, message}} -> error(conn, status, errcode, message)
+    end
+  end
+
+  defp token(nil, name), do: {:error, {400, "M_MISSING_PARAM", "Missing query parameter `#{name}`"}}
+  defp token("", name), do: {:error, {400, "M_MISSING_PARAM", "Missing query parameter `#{name}`"}}
+
+  defp token(value, name) do
+    case DeviceListStore.parse_token(value) do
+      {:ok, pos} -> {:ok, pos}
+      :error -> {:error, {400, "M_INVALID_PARAM", "Invalid sync token in `#{name}`"}}
+    end
+  end
+
+  defp check_json(conn) do
+    if conn.assigns[:json_parse_error] == true, do: {:error, {400, "M_NOT_JSON", "Request body is not valid JSON"}}, else: :ok
+  end
+
+  # `[{user_id, device_id, algorithm}]`; the structure is validated (a 400), the ids are not (an unreachable target is left out silently)
+  defp targets(%{"one_time_keys" => keys}) when is_map(keys) do
+    Enum.reduce_while(keys, {:ok, []}, fn
+      {uid, devices}, {:ok, acc} when is_map(devices) ->
+        case Enum.reduce_while(devices, {:ok, acc}, fn
+               {did, alg}, {:ok, inner} when is_binary(alg) -> {:cont, {:ok, [{uid, did, alg} | inner]}}
+               _, _ -> {:halt, :error}
+             end) do
+          {:ok, inner} -> {:cont, {:ok, inner}}
+          :error -> {:halt, bad_json()}
+        end
+
+      _, _ ->
+        {:halt, bad_json()}
+    end)
+    |> case do
+      {:ok, list} -> {:ok, Enum.reverse(list)}
+      error -> error
+    end
+  end
+
+  defp targets(_), do: bad_json()
+
+  defp bad_json, do: {:error, {400, "M_BAD_JSON", "Request body must be a JSON object with an object member `one_time_keys` of {user: {device: algorithm}}"}}
+
+  defp check_cap(targets) do
+    if length(targets) > @max_targets, do: {:error, {400, "M_INVALID_PARAM", "Too many targets (at most #{@max_targets})"}}, else: :ok
+  end
+
+  defp valid_target?({uid, did, alg}) do
+    ok? = fn s -> String.valid?(s) and byte_size(s) in 1..@max_id_bytes and not String.contains?(s, <<0>>) end
+    ok?.(uid) and ok?.(did) and ok?.(alg) and String.starts_with?(uid, "@") and String.contains?(uid, ":")
+  end
+
+  defp charge(user, valid) do
+    buckets =
+      [{{"keys_claim", user}, 1, @user_per_min, @user_burst}] ++
+        for {uid, did, _alg} <- valid, do: {{"keys_claim_target", user, uid, did}, 1, @target_per_min, @target_burst}
+
+    case Nebu.Web.Plugs.RateLimit.take_all(buckets) do
+      :ok -> :ok
+      {:deny, seconds} -> {:error, {:limited, seconds}}
+    end
+  end
+
+  defp error_kind(%{__struct__: module}), do: inspect(module)
+  defp error_kind(reason) when is_atom(reason), do: Atom.to_string(reason)
+  defp error_kind(_), do: "error"
+end
