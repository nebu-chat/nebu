diff --git a/server/lib/nebu/oauth/last_good.ex b/server/lib/nebu/oauth/last_good.ex
new file mode 100644
index 00000000..939f75f9
--- /dev/null
+++ b/server/lib/nebu/oauth/last_good.ex
@@ -0,0 +1,28 @@
+defmodule Nebu.OAuth.LastGood do
+  @moduledoc """
+  The per-node LAST KNOWN GOOD saved Matrix session lifetime (story session-lifetime-setting, security review Kassandra #1): the last successfully read valid
+  value of `server_config.matrix_session_ttl_seconds`, kept WITHOUT a TTL for as long as the node lives (`:persistent_term`: it survives the cache owner, every cache
+  invalidation and every failed read). Private to the OAuth domain; the reader is `Nebu.OAuth.Config`. A separate module on purpose: `Nebu.OAuth.Config` holds
+  the only TTL cache of the switch state and a static test keeps `:persistent_term` out of it.
+  """
+
+  @key {__MODULE__, :matrix_session_ttl}
+
+  @doc "The last good value, or nil when none was ever loaded on this node (or it was cleared by a successful read that found no row)."
+  @spec get() :: pos_integer() | nil
+  def get, do: :persistent_term.get(@key, nil)
+
+  @doc "Remembers `seconds` (a no-op when unchanged: `:persistent_term.put/2` of a changed value triggers a global GC)."
+  @spec put(pos_integer()) :: pos_integer()
+  def put(seconds) do
+    if get() != seconds, do: :persistent_term.put(@key, seconds)
+    seconds
+  end
+
+  @doc "Forgets it (a successful read found no row: the saved value ended on purpose). Returns nil."
+  @spec clear() :: nil
+  def clear do
+    if get() != nil, do: :persistent_term.erase(@key)
+    nil
+  end
+end
