docker-compose.override.yml

# Node.js (Tailwind CSS / DaisyUI build for the Admin UI)
server/assets/node_modules/

# Elixir / OTP
_build/
deps/
*.beam
.elixir_ls/
.fetch
erl_crash.dump
*.ez
# Override global gitignore: Elixir source lives in lib/
!lib/
/.claude/
/e2e/node_modules/
/e2e/test-results/
.playwright-mcp/

# OpenTofu / Terraform
.terraform/
terraform.tfstate
terraform.tfstate.backup
terraform.tfstate.*.backup
*.tfvars
!*.tfvars.example
.terraform.tfstate.lock.info

# GitLab Pages website - CI-generated copies of docs/ content
# docs/architecture/ and docs/getting-started.md are the single source of truth;
# these copies are generated by the `pages` CI job and must never be committed.
website/dokument/architecture/
website/dokument/getting-started.md
*.pem
