*.out
*.prof

# Go workspace
go.work
go.work.sum

# Dependency directories
vendor/

# Secrets
.secrets/
.env

# gitleaks report output (generated by scripts/scan-secrets.sh --ci)
gitleaks-report.json

# Release-readiness gate report (generated by scripts/release-readiness-gate.sh --report)
release-readiness-report.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

