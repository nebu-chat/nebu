{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "nebu-dev-story",
        "hooks": [
          {
            "type": "command",
            "command": "python3 skills/nebu-pipeline/scripts/invariant_check.py --auto --lib server/lib/"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 skills/nebu-pipeline/scripts/token_metrics.py hook 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 skills/nebu-pipeline/scripts/token_metrics.py hook 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 skills/nebu-pipeline/scripts/read_guard.py 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
