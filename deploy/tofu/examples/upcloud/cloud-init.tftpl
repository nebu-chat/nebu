#cloud-config
# Nebu bootstrap — cloud-init template rendered by OpenTofu templatefile().
# Variables injected at apply time; no hardcoded secrets.
# cloud-init reference: https://cloudinit.readthedocs.io/

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - gnupg
  - lsb-release
  - postgresql-client
%{ if tls_mode == "acme" ~}
  - nginx
  - certbot
  - python3-certbot-nginx
%{ endif ~}

write_files:
  # ── /opt/nebu/.secrets/internal_secret ────────────────────────────────────
  # Quoted scalar — no trailing newline added by YAML block scalar.
  # Bind-mounted into the server container, which runs as the non-root user `nebu` (server/Dockerfile): it must be able to read the
  # file. /opt/nebu/.secrets itself stays 0700 root, so nothing else on the host can reach it.
  - path: /opt/nebu/.secrets/internal_secret
    owner: root:root
    permissions: "0644"
    content: "${internal_secret}"

  # ── One-shot DB grants (UpCloud Managed PostgreSQL) ───────────────────────
  # UpCloud creates nebu_app / nebu_migrate without any privileges on the nebu
  # database, and upcloud_managed_database_logical_database has no `owner`
  # argument (unlike Stackit's stackit_postgresflex_database). Postgres 15+ also
  # revokes CREATE on `public` from PUBLIC, so without these grants nebu_migrate
  # fails with "permission denied for schema public" (42501) on every migration.
  # Run once as the managed-DB admin user, before nebu.service starts.
  # GRANT, not ALTER SCHEMA ... OWNER TO: an ownership transfer requires the
  # admin to be a *member* of the target role, which separately provisioned
  # managed-DB users are not. A plain GRANT only needs the admin to own the
  # schema, which the service admin does as the database's creator.
  - path: /opt/nebu/.secrets/pg_admin_password
    owner: root:root
    permissions: "0600"
    content: "${pg_admin_password}"

  - path: /opt/nebu/db-grants.sh
    owner: root:root
    permissions: "0700"
    content: |
      #!/bin/bash
      # Idempotent; guarded by /opt/nebu/.db-grants-done so it runs only once.
      set -eu
      MARKER=/opt/nebu/.db-grants-done
      [ -f "$MARKER" ] && exit 0
      export PGPASSWORD="$(cat /opt/nebu/.secrets/pg_admin_password)"
      export PGSSLMODE=require
      # The grant itself is the DB-readiness wait: managed DB provisioning can
      # still be in progress at boot. 36 attempts x 10 s = 6 minutes.
      for i in $(seq 1 36); do
        if psql -h ${pg_host} -p ${pg_port} -U ${pg_admin_user} -d nebu -v ON_ERROR_STOP=1 <<'SQL'
      GRANT ALL PRIVILEGES ON DATABASE nebu TO ${pg_user}, ${pg_migrate_user};
      GRANT ALL ON SCHEMA public TO ${pg_user}, ${pg_migrate_user};
      SQL
        then
          touch "$MARKER"
          echo "[nebu-bootstrap] DB grants applied"
          exit 0
        fi
        echo "[nebu-bootstrap] DB grants not applied yet (attempt $i/36), waiting 10s..."
        sleep 10
      done
      echo "[nebu-bootstrap] ERROR: could not apply DB grants" >&2
      exit 1

%{ if enable_media_gateway ~}
  # Bind-mounted into the server container, which runs as the non-root user `nebu` (server/Dockerfile): it must be able to read the
  # file. /opt/nebu/.secrets itself stays 0700 root, so nothing else on the host can reach it.
  - path: /opt/nebu/.secrets/s3_access_key
    owner: root:root
    permissions: "0644"
    content: "${s3_access_key}"

  # Bind-mounted into the server container, which runs as the non-root user `nebu` (server/Dockerfile): it must be able to read the
  # file. /opt/nebu/.secrets itself stays 0700 root, so nothing else on the host can reach it.
  - path: /opt/nebu/.secrets/s3_secret_key
    owner: root:root
    permissions: "0644"
    content: "${s3_secret_key}"

%{ endif ~}
  # ── /opt/nebu/.env ─────────────────────────────────────────────────────────
  # Mode 0600 — contains secrets; readable only by root / docker compose.
  # Database credentials provided by UpCloud Managed PostgreSQL.
  # NOTE: pg_password must not contain URL-reserved characters (@, :, /, ?, #).
  - path: /opt/nebu/.env
    owner: root:root
    permissions: "0600"
    content: |
%{ if oidc_issuer != "" ~}
      NEBU_OIDC_ISSUER=${oidc_issuer}
%{ endif ~}
%{ if oidc_audience != "" ~}
      NEBU_OIDC_AUDIENCE=${oidc_audience}
%{ endif ~}
%{ if oidc_client_secret != "" ~}
      NEBU_ADMIN_OIDC_CLIENT_SECRET=${oidc_client_secret}
%{ endif ~}
%{ if oidc_client_id != "" ~}
      NEBU_ADMIN_OIDC_CLIENT_ID=${oidc_client_id}
%{ endif ~}
      NEBU_SERVER_NAME=${server_name}
      NEBU_IMAGE_REGISTRY=${image_registry}
      NEBU_VERSION=${nebu_version}
      NEBU_PII_ENCRYPTION_KEY=${pii_encryption_key}
%{ if trusted_proxy_cidrs != "" ~}
      # Peers whose X-Forwarded-For Nebu may honour (ADR-033 TP1). Computed by OpenTofu: the pinned
      # nginx proxy container (alb) or the compose bridge gateway (acme, loopback-only published
      # port) unless overridden by var.trusted_proxy_cidrs. Absent for tls_mode = "none".
      NEBU_TRUSTED_PROXY_CIDRS=${trusted_proxy_cidrs}
%{ endif ~}

%{ if oidc_mode == "dex" ~}
  # ── /opt/nebu/dex/config.yaml ──────────────────────────────────────────────
  # Dex static configuration — no database required.
  # Static OIDC client id "nebu-gateway" (registered client identifier, unchanged
  # for backwards compatibility) with the oidc_client_secret from tfvars. Its
  # redirect URIs point at the server service (login SSO callback + /admin/callback).
  # Static user: operator@example.com — see RUNBOOK.md 'OIDC Profiles' to rotate the password hash.
  - path: /opt/nebu/dex/config.yaml
    owner: root:root
    permissions: "0644"
    content: |
      issuer: "${oidc_issuer}"

      storage:
        type: memory

      web:
        http: 0.0.0.0:5556

      oauth2:
        responseTypes: [code]
        skipApprovalScreen: true
        grantTypes:
          - authorization_code
          - refresh_token

      enablePasswordDB: true

      staticClients:
        - id: nebu-gateway
          secret: "${oidc_client_secret}"
          redirectURIs:
            - "${gateway_scheme}://${server_name}${gateway_port}/_matrix/client/v3/login/sso/redirect/oidc"
            - "${gateway_scheme}://${server_name}${gateway_port}/admin/callback"
          name: Nebu Gateway

      staticPasswords:
        - email: "operator@example.com"
          hash: "${dex_static_password_hash}"
          username: "operator"
          userID: "operator-00000000-0000-0000-0000-000000000001"
          groups:
            - instance_admin
%{ if dex_user1_password_hash != null ~}
        - email: "alice@example.com"
          hash: "${dex_user1_password_hash}"
          username: "alice"
          userID: "alice-00000000-0000-0000-0000-000000000002"
          groups:
            - users
%{ endif ~}
%{ if dex_user2_password_hash != null ~}
        - email: "bob@example.com"
          hash: "${dex_user2_password_hash}"
          username: "bob"
          userID: "bob-000000-0000-0000-0000-000000000003"
          groups:
            - users
%{ endif ~}
%{ if dex_compliance_password_hash != null ~}
        - email: "compliance@example.com"
          hash: "${dex_compliance_password_hash}"
          username: "compliance"
          userID: "compliance-0000-0000-0000-000000000004"
          groups:
            - compliance_officer
%{ endif ~}

%{ endif ~}
%{ if enable_element_web ~}
  # ── /opt/nebu/element-config.json ─────────────────────────────────────────
  # Element Web configuration. base_url points to the server service (Matrix CS API).
  # When TLS is enabled, server is served at https://<server_name>.
  # When TLS is disabled, element is on its own port 7070 so the Matrix API
  # is at http://<server_name> (behind the same host, no TLS).
  - path: /opt/nebu/element-config.json
    owner: root:root
    permissions: "0644"
    content: |
      {
        "default_server_config": {
          "m.homeserver": {
            "base_url": "${gateway_scheme}://${server_name}${gateway_port}",
            "server_name": "${server_name}"
          }
        },
        "brand": "Nebu",
        "disable_custom_urls": true,
        "disable_guests": true,
        "disable_3pid_login": true,
        "default_federate": false,
        "default_theme": "dark",
        "room_directory": { "servers": ["${server_name}"] },
        "integrations_ui_url": null,
        "integrations_rest_url": null,
        "integrations_widgets_urls": [],
        "sso_redirect_options": {
          "immediate": false
        },
        "setting_defaults": {
          "UIFeature.registration": false,
          "UIFeature.passwordReset": false,
          "UIFeature.identityServer": false,
          "UIFeature.thirdPartyId": false,
          "breadcrumbs": true
        }
      }

%{ endif ~}
%{ if tls_mode == "alb" ~}
  # ── /opt/nebu/nginx-proxy.conf ─────────────────────────────────────────────
  # Docker Compose nginx proxy — plain HTTP, TWO listeners:
  #   :8081  the LB's TLS-terminated HTTPS traffic (the LB target of the 443 frontend/listener).
  #          Full routing. The ONLY listener that may carry the realip directives.
  #   :80    the LB's plain-HTTP traffic and health probe. Never trusts any X-Forwarded-For;
  #          redirects everything (308) to https://<server_name> except the health path.
  # TLS is terminated at the UpCloud Load Balancer; this proxy only does L7 path routing.
  # X-Forwarded-Proto: https is set explicitly so server sees the correct scheme.
  # Always deployed for tls_mode = "alb" — the UpCloud LB does not forward
  # X-Forwarded-Proto on its own, so nginx is required for all ALB deployments
  # (not just element_web or dex) to ensure OIDC redirect_uri uses https://.
  - path: /opt/nebu/nginx-proxy.conf
    owner: root:root
    permissions: "0644"
    content: |
      # Client-IP trust (ADR-033 TP1-TP14, follow-ups ap1): this nginx is the ONE hop Nebu trusts
      # (NEBU_TRUSTED_PROXY_CIDRS = this container's pinned compose address). Every proxy_pass
      # location OVERWRITES X-Forwarded-For with $remote_addr (never $proxy_add_x_forwarded_for), so
      # Nebu always receives exactly ONE element, written by nginx; a client-written X-Forwarded-For
      # can never choose its rate-limit bucket. $remote_addr is the LB itself (one shared bucket:
      # safe against spoofing, NOT safe for availability) unless lb_real_ip_cidrs lists the LB
      # hop(s) on the :8081 listener below, in which case nginx resolves the real client there.
      # With an empty lb_real_ip_cidrs one anonymous source can lock every user out of login:
      # do NOT enable oauth_enabled in that state (positive test, README). The :80 listener has
      # NO realip directives on purpose: it is reachable through the LB's plain-HTTP
      # frontend/listener, where a client could write X-Forwarded-For. Negative test: send a
      # forged X-Forwarded-For through the LB over https:// AND http://, over IPv4 and IPv6; the
      # device's last_seen_ip must never show the forged value.

      map $http_upgrade $connection_upgrade {
          default upgrade;
          ''      close;
      }

      # Access log WITHOUT query strings (follow-ups gate k): $uri is the normalised path only, never
      # $request / $request_uri / $http_referer, so /oauth2/authorize (state, code_challenge,
      # login_hint), the SSO callback (code, state) and /account (device ids, actions) never land in
      # the log. nginx's error_log would print the full request line (query string, referrer) for
      # upstream errors (502/504) at level error; 'crit' suppresses those (residual: upstream
      # failures are then no longer diagnosable from this container's stderr, use the access log's
      # status/rt= and the server logs).
      log_format nebu_noquery '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                              '$status $body_bytes_sent "$http_user_agent" rt=$request_time';
      error_log /dev/stderr crit;

      # Listener :80 - LB plain-HTTP traffic and health probe. No realip, no proxying of user
      # traffic: everything but the health path is redirected to https://<server_name>.
      server {
          listen 80;
          server_name ${server_name};

          access_log /dev/stdout nebu_noquery;

          # LB health probe (HTTP backend/pool check). Overwrites X-Forwarded-For like every other
          # proxied location.
          location = /_matrix/client/versions {
              proxy_pass         http://server:4000;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto http;
          }

          location / {
              return 308 https://${server_name}$request_uri;
          }
      }

      # Listener :8081 - the LB's TLS-terminated traffic. Full routing below.
      server {
          listen 8081;
          server_name ${server_name};

          access_log /dev/stdout nebu_noquery;

%{ if length(lb_real_ip_cidrs) > 0 ~}
          # nginx (not Nebu) resolves the real client behind the LB. Only the listed LB hop(s) are
          # trusted to have APPENDED the client address to X-Forwarded-For; real_ip_recursive then
          # takes the right-most address that is not itself a listed hop. Never list an LB that
          # merely forwards a client-written header: that lets a client pick its own address.
%{ for cidr in lb_real_ip_cidrs ~}
          set_real_ip_from ${cidr};
%{ endfor ~}
          real_ip_header X-Forwarded-For;
          real_ip_recursive on;

%{ endif ~}
          client_max_body_size 50m;
          proxy_read_timeout    90s;
          proxy_send_timeout    90s;
          proxy_connect_timeout 10s;
          # The admin sign-in answers with a long redirect plus cookies: the 4k default header buffer ends in 502 (upstream sent too big header).
          proxy_buffer_size       16k;
          proxy_buffers           8 16k;
          proxy_busy_buffers_size 32k;
%{ if oidc_mode == "dex" ~}

          location /dex/ {
              proxy_pass         http://dex:5556;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }
%{ endif ~}
%{ if enable_element_web ~}

          location /_matrix/ {
              proxy_pass         http://server:4000;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        $connection_upgrade;
              client_max_body_size 50m;
          }

          location /.well-known/matrix/ {
              proxy_pass         http://server:4000;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          # OAuth 2.0 authorization server (authorize, token, revoke, register, jwks). Must reach the
          # server, not Element: without this route the token endpoint and the JWKS are unreachable.
          location /oauth2/ {
              proxy_pass         http://server:4000;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          # OAuth account page. Exact match + the /account/ prefix below, NOT a bare prefix
          # /account, which would also capture unrelated paths such as /accounts-foo.
          location = /account {
              proxy_pass         http://server:4000;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          # Every /account/* sub-path (devices, reauth, logout, cross_signing_reset, ...).
          location /account/ {
              proxy_pass         http://server:4000;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          # OpenID provider metadata (same document as the Matrix auth metadata). The
          # /.well-known/matrix/ prefix above does not cover it.
          location = /.well-known/openid-configuration {
              proxy_pass         http://server:4000;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          location /admin/ {
              proxy_pass         http://server:4000;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        $connection_upgrade;
          }

          location /api/v1/ {
              proxy_pass         http://server:4000;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          location / {
              proxy_pass         http://element:80;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        $connection_upgrade;
          }
%{ else ~}

          location / {
              proxy_pass         http://server:4000;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        $connection_upgrade;
              client_max_body_size 50m;
          }
%{ endif ~}
      }

%{ endif ~}
%{ if tls_mode == "acme" ~}
  # ── /etc/nginx/sites-available/nebu ────────────────────────────────────────
  # certbot --nginx runs after nginx starts and adds the SSL server block + redirect.
  # This initial config contains only the port-80 server with proxy settings.
  - path: /etc/nginx/sites-available/nebu
    owner: root:root
    permissions: "0644"
    content: |
      # Client-IP trust (ADR-033 TP1-TP14, follow-ups ap1): this host nginx is the ONE hop Nebu
      # trusts. It reaches the server through the loopback-only published port 127.0.0.1:8008, which
      # Docker delivers from the compose bridge gateway; NEBU_TRUSTED_PROXY_CIDRS is that gateway /32,
      # valid ONLY because the port is bound to loopback (nobody outside the VM can claim it). Every
      # proxy_pass location OVERWRITES X-Forwarded-For with $remote_addr (never
      # $proxy_add_x_forwarded_for), so Nebu receives exactly ONE element, written by nginx. With a
      # TCP-mode LB in front (the only mode here) $remote_addr is the LB or the client, whichever the
      # LB preserves; either is safe. Negative test: send a forged X-Forwarded-For; last_seen_ip must
      # never show it.

      map $http_upgrade $connection_upgrade {
          default upgrade;
          ''      close;
      }

      # Access log WITHOUT query strings (follow-ups gate k): $uri is the normalised path only, never
      # $request / $request_uri / $http_referer, so /oauth2/authorize (state, code_challenge,
      # login_hint), the SSO callback (code, state) and /account (device ids, actions) never land in
      # the log. nginx's error_log would print the full request line (query string, referrer) for
      # upstream errors (502/504) at level error; 'crit' suppresses those. This directive sits in
      # the http context of the included file, so the server block certbot generates for 443
      # inherits it. Residuals: certbot's port-80 redirect block and /var/log/nginx/access.log
      # keep nginx's default (combined) access log format, which includes the query string; those
      # only ever see plain-http requests that get redirected.
      log_format nebu_noquery '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                              '$status $body_bytes_sent "$http_user_agent" rt=$request_time';
      error_log /var/log/nginx/nebu-error.log crit;

      # NOTE (acme): until certbot has succeeded this port-80 server proxies everything and sets
      # X-Forwarded-Proto https although the request is plain http. certbot --redirect then adds
      # the redirect; it must not be pre-empted here or the HTTP-01 challenge would break.
      # Check after bootstrap: curl -sI http://<server_name>/ must answer 301 to https://.
      server {
          listen 80;
          server_name ${server_name};

          access_log /var/log/nginx/nebu-access.log nebu_noquery;

          client_max_body_size 50m;

          # Matrix /sync uses long-polling — generous timeouts required.
          proxy_read_timeout    90s;
          proxy_send_timeout    90s;
          proxy_connect_timeout 10s;
          # The admin sign-in answers with a long redirect plus cookies: the 4k default header buffer ends in 502 (upstream sent too big header).
          proxy_buffer_size       16k;
          proxy_buffers           8 16k;
          proxy_busy_buffers_size 32k;
%{ if oidc_mode == "dex" ~}

          # Dex OIDC provider — accessible via path prefix (nginx proxies to local port 5556).
          location /dex/ {
              proxy_pass         http://127.0.0.1:5556;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }
%{ endif ~}
%{ if enable_element_web ~}

          location /_matrix/ {
              proxy_pass         http://127.0.0.1:8008;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        $connection_upgrade;
              client_max_body_size 50m;
          }

          location /.well-known/matrix/ {
              proxy_pass         http://127.0.0.1:8008;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          # OAuth 2.0 authorization server (authorize, token, revoke, register, jwks). Must reach the
          # server, not Element: without this route the token endpoint and the JWKS are unreachable.
          location /oauth2/ {
              proxy_pass         http://127.0.0.1:8008;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          # OAuth account page. Exact match + the /account/ prefix below, NOT a bare prefix
          # /account, which would also capture unrelated paths such as /accounts-foo.
          location = /account {
              proxy_pass         http://127.0.0.1:8008;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          # Every /account/* sub-path (devices, reauth, logout, cross_signing_reset, ...).
          location /account/ {
              proxy_pass         http://127.0.0.1:8008;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          # OpenID provider metadata (same document as the Matrix auth metadata). The
          # /.well-known/matrix/ prefix above does not cover it.
          location = /.well-known/openid-configuration {
              proxy_pass         http://127.0.0.1:8008;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          location /admin/ {
              proxy_pass         http://127.0.0.1:8008;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        $connection_upgrade;
          }

          # Internal/compliance API paths — routed to server (not Element).
          location /api/v1/ {
              proxy_pass         http://127.0.0.1:8008;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
          }

          # Everything else — Element Web client.
          location / {
              proxy_pass         http://127.0.0.1:7070;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        $connection_upgrade;
          }
%{ else ~}

          location / {
              proxy_pass         http://127.0.0.1:8008;
              proxy_http_version 1.1;
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $remote_addr;
              proxy_set_header   X-Forwarded-Proto https;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        $connection_upgrade;
              client_max_body_size 50m;
          }
%{ endif ~}
      }

%{ endif ~}
  # ── /opt/nebu/docker-compose.yml ───────────────────────────────────────────
  # Mode 0600 — tightened for security.
  - path: /opt/nebu/docker-compose.yml
    owner: root:root
    permissions: "0600"
    content: |
      name: nebu

      secrets:
        internal_secret:
          file: .secrets/internal_secret
%{ if enable_media_gateway ~}
        s3_access_key:
          file: .secrets/s3_access_key
        s3_secret_key:
          file: .secrets/s3_secret_key
%{ endif ~}

%{ if tls_mode == "acme" || tls_mode == "alb" ~}
      # Pinned subnet so the trusted proxy peer address is stable and known at render time
      # (follow-ups ap1, ADR-033 TP14). The gateway is the host's address on this bridge; the
      # proxy container (alb) gets a fixed address below. ip_range confines Docker's dynamic
      # address pool to the upper half of the subnet, so the static proxy address and the gateway
      # can never be handed to another container (which would then be the trusted peer).
      # Compose names the network nebu_default.
      networks:
        default:
          ipam:
            config:
              - subnet: ${compose_subnet}
                ip_range: ${compose_ip_range}
                gateway: ${compose_gateway}

%{ endif ~}
      services:
%{ if oidc_mode == "dex" ~}
        dex:
          image: dexidp/dex:v2.45.1
          restart: unless-stopped
          command: ["dex", "serve", "/etc/dex/config.yaml"]
          volumes:
            - /opt/nebu/dex/config.yaml:/etc/dex/config.yaml:ro
          ports:
            - "5556:5556"
          healthcheck:
            # dexidp/dex:v2.45.1 is Alpine-based and includes busybox wget
            test: ["CMD", "wget", "-qO-", "http://localhost:5556/dex/.well-known/openid-configuration"]
            interval: 10s
            timeout: 5s
            retries: 3
            start_period: 10s
          deploy:
            resources:
              limits:
                cpus: '${dex_cpu_limit}'
                memory: ${dex_memory_limit}
%{ endif ~}
%{ if enable_media_gateway ~}
        # ADR-024: self-hosted ClamAV, no file content/hash leaves the deployment.
        # Kassandra security review (F-4, 2026-07-13): clamd has no authentication
        # and its control protocol includes verbs like SHUTDOWN — deliberately no
        # `ports:` mapping here, reachable only from `server` over the private
        # compose network by service name (matches Nebu.Media.ClamAV's
        # NEBU_CLAMAV_HOST/PORT defaults, "clamav"/3310 — no env override needed).
        clamav:
          image: clamav/clamav:stable
          restart: unless-stopped
          volumes:
            - clamav_data:/var/lib/clamav
          healthcheck:
            # Bundled in the clamav/clamav image specifically for container healthchecks.
            test: ["CMD", "clamdcheck.sh"]
            interval: 30s
            timeout: 10s
            retries: 5
            # freshclam's first signature database download can take a few minutes.
            start_period: 180s
          deploy:
            resources:
              limits:
                cpus: '${clamav_cpu_limit}'
                memory: ${clamav_memory_limit}
%{ endif ~}
        server:
          image: $${NEBU_IMAGE_REGISTRY}/nebu-server:$${NEBU_VERSION}
          restart: unless-stopped
          # No depends_on: postgres — managed PostgreSQL is always available
%{ if fetch_postgres_ca ~}
          volumes:
            - /opt/nebu/postgres-ca.pem:/opt/nebu/postgres-ca.pem:ro
%{ endif ~}
%{ if enable_media_gateway ~}
          secrets:
            - internal_secret
            - s3_access_key
            - s3_secret_key
%{ else ~}
          secrets: [internal_secret]
%{ endif ~}
          environment:
            NEBU_DB_URL: "postgresql://${pg_user}:${pg_password}@${pg_host}:${pg_port}/nebu"
            NEBU_DB_URL_MIGRATE: "postgresql://${pg_migrate_user}:${pg_migrate_password}@${pg_host}:${pg_port}/nebu"
            NEBU_POSTGRES_SSL: "true"
            NEBU_INTERNAL_SECRET_FILE: "/run/secrets/internal_secret"
            NEBU_SERVER_NAME: $${NEBU_SERVER_NAME}
%{ if oidc_issuer != "" ~}
            NEBU_OIDC_ISSUER: $${NEBU_OIDC_ISSUER}
%{ endif ~}
%{ if oidc_audience != "" ~}
            NEBU_OIDC_AUDIENCE: $${NEBU_OIDC_AUDIENCE}
%{ endif ~}
%{ if oidc_client_secret != "" ~}
            NEBU_ADMIN_OIDC_CLIENT_SECRET: $${NEBU_ADMIN_OIDC_CLIENT_SECRET}
%{ endif ~}
%{ if oidc_client_id != "" ~}
            NEBU_ADMIN_OIDC_CLIENT_ID: $${NEBU_ADMIN_OIDC_CLIENT_ID}
%{ endif ~}
%{ if enable_media_gateway ~}
            # Media object storage — server serves /_matrix/media from the S3 bucket.
            NEBU_MINIO_ENDPOINT: "${s3_endpoint}"
%{ if s3_iam_endpoint != "" ~}
            NEBU_MINIO_IAM_ENDPOINT: "${s3_iam_endpoint}"
%{ endif ~}
%{ if s3_sts_endpoint != "" ~}
            NEBU_MINIO_STS_ENDPOINT: "${s3_sts_endpoint}"
%{ endif ~}
            # The VM reaches Managed Object Storage over the private network; the
            # *-private endpoints resolve to CGNAT addresses (100.64.0.0/10) that the
            # storage-endpoint SSRF guard otherwise rejects.
            NEBU_STORAGE_ALLOW_PRIVATE_ENDPOINTS: "true"
            NEBU_MINIO_ACCESS_KEY_FILE: "/run/secrets/s3_access_key"
            NEBU_MINIO_SECRET_KEY_FILE: "/run/secrets/s3_secret_key"
            NEBU_MINIO_BUCKET: "${s3_bucket}"
            NEBU_MINIO_USE_SSL: "true"
%{ endif ~}
          env_file:
            - .env
          ports:
%{ if tls_mode == "none" ~}
            # tls_mode = "none": the LB targets host port 8008 directly, so it must stay published
            # on all interfaces and NO trusted proxy is configured (every client is its own peer).
            - "8008:4000"
            - "8080:4000"
%{ else ~}
            # Loopback only (follow-ups ap1, ADR-033 TP14): nothing outside the VM may reach the
            # server and claim the trusted proxy peer address. acme: host nginx connects to 127.0.0.1:8008
            # (Docker delivers it from the bridge gateway, which is what NEBU_TRUSTED_PROXY_CIDRS
            # trusts). alb: the proxy container reaches server:4000 over the compose network and
            # these ports are only for on-host debugging.
            - "127.0.0.1:8008:4000"
            - "127.0.0.1:8080:4000"
%{ endif ~}
          healthcheck:
            test: ["CMD", "curl", "-f", "http://localhost:4000/health"]
            interval: 10s
            timeout: 5s
            retries: 3
            start_period: 30s
          deploy:
            resources:
              limits:
                cpus: '${server_cpu_limit}'
                memory: ${server_memory_limit}
%{ if enable_element_web ~}

        element:
          image: vectorim/element-web:v1.12.22
          restart: unless-stopped
          volumes:
            - /opt/nebu/element-config.json:/usr/share/nginx/html/config.json:ro
%{ if tls_mode == "acme" ~}
          ports:
            - "127.0.0.1:7070:80"
%{ endif ~}
%{ if tls_mode == "none" ~}
          ports:
            - "0.0.0.0:7070:80"
%{ endif ~}
          depends_on:
            server:
              condition: service_healthy
          healthcheck:
            # vectorim/element-web is nginx-alpine-based and includes busybox wget.
            test: ["CMD", "wget", "-qO-", "http://localhost/"]
            interval: 10s
            timeout: 5s
            retries: 3
            start_period: 10s
          deploy:
            resources:
              limits:
                cpus: '${element_cpu_limit}'
                memory: ${element_memory_limit}
%{ endif ~}
%{ if tls_mode == "alb" ~}

        proxy:
          image: nginx:alpine
          restart: unless-stopped
          # Fixed address: the ONLY peer Nebu trusts for X-Forwarded-For (alb mode). Must equal
          # the /32 in NEBU_TRUSTED_PROXY_CIDRS (derived from the same compose_subnet).
          networks:
            default:
              ipv4_address: ${compose_proxy_ip}
          volumes:
            - /opt/nebu/nginx-proxy.conf:/etc/nginx/conf.d/default.conf:ro
          ports:
            - "0.0.0.0:80:80"
            - "0.0.0.0:8081:8081"
          depends_on:
            server:
              condition: service_healthy
%{ if enable_element_web ~}
            element:
              condition: service_healthy
%{ endif ~}
          healthcheck:
            # :80 only redirects; probe the full-routing listener.
            test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8081/"]
            interval: 10s
            timeout: 5s
            retries: 3
            start_period: 5s
          deploy:
            resources:
              limits:
                cpus: '0.25'
                memory: 64m
%{ endif ~}
%{ if enable_media_gateway ~}

      volumes:
        clamav_data:
%{ endif ~}

  # ── /etc/systemd/system/nebu.service ───────────────────────────────────────
  # Type=simple: systemd manages the docker compose process directly (no -d flag).
  # This allows systemd to track health and restart on failure correctly.
  - path: /etc/systemd/system/nebu.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Nebu Chat Server (Docker Compose)
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      WorkingDirectory=/opt/nebu
      ExecStart=/usr/bin/docker compose -f /opt/nebu/docker-compose.yml up
      ExecStop=/usr/bin/docker compose -f /opt/nebu/docker-compose.yml down
      Restart=on-failure
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

runcmd:
  # ── Docker CE install ───────────────────────────────────────────────────────
  # Retries guard against transient DNS/egress failures in the first seconds of
  # boot — a failed GPG fetch or `apt-get update` here does not abort runcmd, so
  # apt-get install would otherwise proceed against an unindexed repo and fail
  # with "docker-ce has no installation candidate".
  - install -m 0755 -d /etc/apt/keyrings
  - |
    for i in $(seq 1 10); do
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
        && [ -s /etc/apt/keyrings/docker.asc ] && break
      echo "[nebu-bootstrap] docker gpg key fetch attempt $i failed, retrying in 10s..."
      sleep 10
    done
  - chmod a+r /etc/apt/keyrings/docker.asc
  - |
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
      https://download.docker.com/linux/ubuntu \
      $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
      > /etc/apt/sources.list.d/docker.list
  - |
    for i in $(seq 1 10); do
      apt-get update -y \
        && apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin \
        && break
      echo "[nebu-bootstrap] docker-ce install attempt $i failed, retrying in 15s..."
      sleep 15
    done
  - |
    dpkg -s docker-ce >/dev/null 2>&1 \
      || echo "[nebu-bootstrap] WARNING: docker-ce failed to install after retries — nebu.service will not start." >&2

  # ── Nebu directory + secrets ────────────────────────────────────────────────
  - mkdir -p /opt/nebu/.secrets
%{ if oidc_mode == "dex" ~}
  - mkdir -p /opt/nebu/dex
%{ endif ~}
  - chmod 0700 /opt/nebu/.secrets
  - chmod 0700 /opt/nebu
  - chmod 0600 /opt/nebu/docker-compose.yml

%{ if tls_mode == "acme" ~}
  # ── nginx + certbot TLS setup ───────────────────────────────────────────────
  - ln -sf /etc/nginx/sites-available/nebu /etc/nginx/sites-enabled/nebu
  - rm -f /etc/nginx/sites-enabled/default
  - nginx -t
  - systemctl enable nginx
  - systemctl start nginx
  # certbot --nginx: HTTP-01 challenge via the LB port-80 listener.
  # Retry up to 5 times (60 s apart) to allow DNS propagation + LB warm-up.
  # On success certbot: adds SSL to the nginx config, redirects HTTP→HTTPS, schedules renewal.
  - |
    for i in 1 2 3 4 5; do
      certbot --nginx \
        --non-interactive \
        --agree-tos \
        --email ${acme_email} \
        --domains ${server_name} \
        --redirect \
%{ if acme_staging ~}
        --test-cert \
%{ endif ~}
        && break
      echo "certbot attempt $i failed — retrying in 60 s"
      sleep 60
    done
    # certbot adds the 443 server block on success. Without it nginx keeps serving the plain-HTTP
    # vhost (X-Forwarded-Proto https on cleartext) — make that loud in the journal.
    if ! grep -q "listen .*443" /etc/nginx/sites-available/nebu; then
      echo "[nebu-bootstrap] WARNING: certbot did not succeed; nginx serves plain HTTP only. Fix DNS/LB and re-run: certbot --nginx --redirect --domains ${server_name}" >&2
    fi

%{ endif ~}
%{ if fetch_postgres_ca ~}
  # ── Fetch PostgreSQL server CA certificate ──────────────────────────────────
  # UpCloud Managed PostgreSQL uses Aiven's internal CA — not in the system
  # trust store. Extract the TLS certificate chain from the DB host at boot time
  # via the private SDN. All certs in the chain are saved so Postgrex verify_peer
  # can validate the server certificate.
  # NEBU_POSTGRES_CA_CERT_FILE is appended to .env before the container starts.
  # 36 attempts × 10 s = 6 minutes — enough for UpCloud managed DB provisioning.
  - |
    for i in $(seq 1 36); do
      CERTS=$(echo Q | openssl s_client -connect ${pg_host}:${pg_port} -showcerts 2>/dev/null \
        | sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p')
      if [ -n "$CERTS" ]; then
        printf '%s\n' "$CERTS" > /opt/nebu/postgres-ca.pem
        chmod 0644 /opt/nebu/postgres-ca.pem
        echo "NEBU_POSTGRES_CA_CERT_FILE=/opt/nebu/postgres-ca.pem" >> /opt/nebu/.env
        echo "[nebu-bootstrap] PostgreSQL CA cert saved to /opt/nebu/postgres-ca.pem"
        break
      fi
      echo "[nebu-bootstrap] DB not reachable yet (attempt $i/36), waiting 10s..."
      sleep 10
    done
    if [ ! -f /opt/nebu/postgres-ca.pem ]; then
      echo "[nebu-bootstrap] WARNING: Could not fetch PostgreSQL CA cert after 36 attempts." >&2
      echo "[nebu-bootstrap] WARNING: Server will start with verify_none (encrypted, unverified)." >&2
    fi

%{ endif ~}
  # ── One-shot DB grants (admin user) — must precede nebu.service ────────────
  - /opt/nebu/db-grants.sh

  # ── Enable + start nebu.service ─────────────────────────────────────────────
  - systemctl daemon-reload
  - systemctl enable nebu.service
  - systemctl start docker.service
  - sleep 2
  - systemctl start nebu.service
