terraform {
  required_version = ">= 1.6.0"

  required_providers {
    upcloud = {
      source  = "UpCloudLtd/upcloud"
      version = "~> 5.0"
    }
  }

  # Backend: UpCloud Managed Object Storage (S3-compatible). Configure before use.
  # Uncomment and fill in values — do NOT commit credentials.
  #
  # backend "s3" {
  #   bucket                      = "my-tofu-state"
  #   key                         = "nebu/upcloud/terraform.tfstate"
  #   endpoint                    = "https://<service-name>.objectstorage.<region>.upcloudobjects.com"
  #   region                      = "us-east-1"  # dummy region required by S3 backend
  #   skip_credentials_validation = true
  #   skip_region_validation      = true
  #   skip_metadata_api_check     = true
  #   access_key                  = "<REPLACE: upcloud managed object storage access key>"
  #   secret_key                  = "<REPLACE: upcloud managed object storage secret key>"
  # }
}

provider "upcloud" {
  # Token takes precedence over username + password when both are set.
  token    = var.upcloud_token
  username = var.upcloud_username
  password = var.upcloud_password
}

# Validate that at least one auth method is configured.
locals {
  _auth_check = (var.upcloud_token != null) || (var.upcloud_username != "" && var.upcloud_password != "")
}

resource "terraform_data" "auth_check" {
  lifecycle {
    precondition {
      condition     = local._auth_check
      error_message = "Provide either upcloud_token or both upcloud_username + upcloud_password."
    }
  }
}

# ── UpCloud Managed Object Storage (optional) ─────────────────────────────────
# Creates the S3-compatible bucket for media storage when enable_media_gateway = true.
# Credentials are generated by OpenTofu and injected into cloud-init at first boot —
# no manual portal step required (unlike StackIT where credentials are created manually).

resource "upcloud_managed_object_storage" "nebu_media" {
  count             = var.enable_media_gateway ? 1 : 0
  name              = "nebu-${var.environment}-media"
  region            = var.object_storage_region
  configured_status = "started"
}

resource "upcloud_managed_object_storage_bucket" "nebu_media" {
  count        = var.enable_media_gateway ? 1 : 0
  service_uuid = upcloud_managed_object_storage.nebu_media[0].id
  name         = var.s3_bucket
}

resource "upcloud_managed_object_storage_user" "nebu_media" {
  count        = var.enable_media_gateway ? 1 : 0
  service_uuid = upcloud_managed_object_storage.nebu_media[0].id
  username     = "nebu-media"
}

resource "upcloud_managed_object_storage_user_access_key" "nebu_media" {
  count        = var.enable_media_gateway ? 1 : 0
  service_uuid = upcloud_managed_object_storage.nebu_media[0].id
  username     = upcloud_managed_object_storage_user.nebu_media[0].username
  status       = "Active"
}
