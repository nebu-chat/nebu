# ── OIDC / TLS locals ─────────────────────────────────────────────────────────

locals {
  tls_enabled           = var.tls_mode != "none"
  dex_issuer            = local.tls_enabled ? "https://${var.server_name}/dex" : "http://${var.server_name}:5556/dex"
  effective_oidc_issuer = var.oidc_mode == "dex" ? local.dex_issuer : var.oidc_issuer

  gateway_scheme = local.tls_enabled ? "https" : "http"
  gateway_port   = local.tls_enabled ? "" : ":8008"

  # ── Client-IP trust (ADR-033 TP1-TP14, follow-ups ap1) ──────────────────────
  # Compose bridge gateway = peer address of host nginx (acme, reaches the server through the
  # loopback-published port); .10 = fixed address of the nginx proxy container (alb).
  compose_gateway  = cidrhost(var.compose_subnet, 1)
  compose_proxy_ip = cidrhost(var.compose_subnet, 10)
  # Docker's dynamic pool = upper half of the subnet, so .1 (gateway) and .10 (proxy) stay static.
  compose_ip_range = cidrsubnet(var.compose_subnet, 1, 1)
  # Mode of the 443 frontend (also used by loadbalancer.tf and the lb_real_ip_cidrs precondition).
  lb_https_frontend_mode = contains(["alb", "dynamic"], var.tls_mode) ? "http" : "tcp"
  nginx_tls_mode         = var.tls_mode == "dynamic" ? "alb" : var.tls_mode
  # tls_mode = "none" keeps the public 8008 port (the LB targets it) and trusts NO proxy.
  derived_trusted_proxy_cidrs = (
    local.nginx_tls_mode == "acme" ? "${local.compose_gateway}/32" : (
      local.nginx_tls_mode == "alb" ? "${local.compose_proxy_ip}/32" : ""
    )
  )
  # An explicit operator value replaces the derived one.
  trusted_proxy_cidrs = var.trusted_proxy_cidrs != "" ? var.trusted_proxy_cidrs : local.derived_trusted_proxy_cidrs

  # IPv4 address ranges as integers (start/end) for the overlap / containment checks in the
  # lifecycle preconditions below (no cidrcontains() in OpenTofu; this works on any version).
  _cidr_inputs = {
    compose = var.compose_subnet
    network = var.network_cidr
  }
  _cidr_bounds = {
    for k, c in local._cidr_inputs : k => {
      start = sum([for i, o in split(".", cidrhost(c, 0)) : tonumber(o) * pow(256, 3 - i)])
      end   = sum([for i, o in split(".", cidrhost(c, -1)) : tonumber(o) * pow(256, 3 - i)])
    }
  }
  compose_overlaps_network = (
    local._cidr_bounds.compose.start <= local._cidr_bounds.network.end &&
    local._cidr_bounds.network.start <= local._cidr_bounds.compose.end
  )
  # Every lb_real_ip_cidrs entry must lie completely inside network_cidr (the LB hop is a member
  # of the private network). IPv6 / unparsable entries evaluate to false.
  lb_real_ip_cidrs_in_network = alltrue([
    for c in var.lb_real_ip_cidrs : try(
      sum([for i, o in split(".", cidrhost(c, 0)) : tonumber(o) * pow(256, 3 - i)]) >= local._cidr_bounds.network.start &&
      sum([for i, o in split(".", cidrhost(c, -1)) : tonumber(o) * pow(256, 3 - i)]) <= local._cidr_bounds.network.end,
      false
    )
  ])

  # Object Storage — credentials generated by UpCloud, not user-provided.
  # Access key + secret are stored in Terraform state (use encrypted remote state).
  s3_access_key = var.enable_media_gateway ? upcloud_managed_object_storage_user_access_key.nebu_media[0].access_key_id : ""
  s3_secret_key = var.enable_media_gateway ? upcloud_managed_object_storage_user_access_key.nebu_media[0].secret_access_key : ""
  # Endpoint of the managed object storage service. A public endpoint is preferred; a service that is attached
  # ONLY to the private network (this example: network { name = "nebu-network" }) exposes just a "private" one
  # (<id>-private.upcloudobjects.com), which the VM reaches over the SDN (cloud-init sets
  # NEBU_STORAGE_ALLOW_PRIVATE_ENDPOINTS). Filtering on "public" alone left the value empty, and the server then
  # tried to upload to "https:///<bucket>/<key>" (nxdomain, 500 "Failed to store media file"). The precondition on
  # upcloud_server.nebu makes an empty endpoint fail at plan/apply instead.
  s3_endpoint_entries = var.enable_media_gateway ? upcloud_managed_object_storage.nebu_media[0].endpoint : []
  s3_endpoint_entry = try(
    [for ep in local.s3_endpoint_entries : ep if ep.type == "public"][0],
    local.s3_endpoint_entries[0],
    null
  )
  s3_endpoint = local.s3_endpoint_entry == null ? "" : local.s3_endpoint_entry.domain_name
  # bugfix-upcloud-s3-iam-sts-endpoints (AC3): the same endpoint entry also carries separate IAM/STS URLs
  # (distinct from the S3 endpoint above) that the S3 driver needs passed through as-is.
  s3_iam_endpoint = local.s3_endpoint_entry == null ? "" : local.s3_endpoint_entry.iam_url
  s3_sts_endpoint = local.s3_endpoint_entry == null ? "" : local.s3_endpoint_entry.sts_url
}

# ── VM ────────────────────────────────────────────────────────────────────────
# Ubuntu 24.04 LTS — uses the official UpCloud template name.
# Verify current template name: upctl storage list --type template | grep Ubuntu
#
# SECURITY NOTE: cloud-init template including secrets is stored in Terraform state.
# Use an encrypted remote state backend (UpCloud Managed Object Storage) in production.
# Never commit .tfstate files. See the backend "s3" block in main.tf.
#
# Traffic flow when tls_mode = "none":
#   Client → LB:443 (TCP passthrough) → VM:8008 (server container port 4000)
# Traffic flow when tls_mode = "acme":
#   Client → LB:443 (TCP passthrough) → VM:443 (nginx, TLS termination) → localhost:8008
#   Client → LB:80  (TCP passthrough) → VM:80  (nginx, 301 → https://<server_name>)
# Traffic flow when tls_mode = "dynamic" (recommended):
#   Client → LB:443 (HTTP, TLS terminated at LB, auto Let's Encrypt cert, set_forwarded_headers) → VM:8081 (Docker nginx proxy → server:4000)
#   Client → LB:80  (HTTP mode: ACME HTTP-01 challenge handled by LB; everything else 301 → https). VM:80 (nginx) only redirects, as a second layer.
# Traffic flow when tls_mode = "alb" (manual cert):
#   Client → LB:443 (HTTP, TLS terminated at LB, set_forwarded_headers) → VM:8081 (Docker nginx proxy → server:4000)
#   Client → LB:80  (HTTP mode, 301 → https). VM:80 (nginx) only redirects, as a second layer.

resource "upcloud_server" "nebu" {
  hostname = "nebu-${var.environment}"
  zone     = var.zone
  plan     = var.vm_plan
  firewall = true
  metadata = true
  template {
    storage = var.vm_template
    size    = var.vm_size
  }

  # Public interface — SSH access and internet egress.
  network_interface {
    type = "public"
  }

  # Private interface — load balancer → server communication.
  network_interface {
    type    = "private"
    network = upcloud_network.nebu.id
  }

  login {
    user            = "ubuntu"
    keys            = [var.ssh_public_key]
    create_password = false
  }

  user_data = templatefile("${path.module}/cloud-init.tftpl", {
    internal_secret              = var.internal_secret
    oidc_client_secret           = var.oidc_client_secret != null ? var.oidc_client_secret : ""
    oidc_client_id               = var.oidc_client_id != null ? var.oidc_client_id : ""
    oidc_issuer                  = local.effective_oidc_issuer
    oidc_audience                = var.oidc_audience != "" ? var.oidc_audience : (var.oidc_client_id != null ? var.oidc_client_id : "")
    oidc_mode                    = var.oidc_mode
    dex_static_password_hash     = var.oidc_mode == "dex" ? var.dex_static_password_hash : ""
    dex_user1_password_hash      = var.oidc_mode == "dex" ? var.dex_user1_password_hash : null
    dex_user2_password_hash      = var.oidc_mode == "dex" ? var.dex_user2_password_hash : null
    dex_compliance_password_hash = var.oidc_mode == "dex" ? var.dex_compliance_password_hash : null
    server_name                  = var.server_name
    image_registry               = var.image_registry
    nebu_version                 = var.nebu_version
    # UpCloud Managed PostgreSQL — connection via private service host.
    # service_port is typically 11550 on UpCloud managed PostgreSQL.
    pg_host             = upcloud_managed_database_postgresql.nebu.service_host
    pg_port             = upcloud_managed_database_postgresql.nebu.service_port
    pg_user             = upcloud_managed_database_user.nebu_app.username
    pg_password         = upcloud_managed_database_user.nebu_app.password
    pg_migrate_user     = upcloud_managed_database_user.nebu_migrate.username
    pg_migrate_password = upcloud_managed_database_user.nebu_migrate.password
    # Service admin (superuser) — used once at boot to hand schema ownership to
    # nebu_migrate. upcloud_managed_database_logical_database has no `owner`
    # argument (unlike Stackit's stackit_postgresflex_database), and Postgres 15+
    # revokes CREATE on `public` from PUBLIC by default, so nebu_migrate cannot
    # otherwise create schema_migrations / run migrations.
    pg_admin_user     = upcloud_managed_database_postgresql.nebu.service_username
    pg_admin_password = upcloud_managed_database_postgresql.nebu.service_password
    # TLS — "dynamic" uses the same VM-side nginx setup as "alb"; only the cert
    # management differs (UpCloud LB handles it vs. manual PEM upload).
    tls_mode       = var.tls_mode == "dynamic" ? "alb" : var.tls_mode
    acme_email     = var.acme_email
    acme_staging   = var.acme_staging
    gateway_scheme = local.gateway_scheme
    gateway_port   = local.gateway_port
    # Client-IP trust: pinned compose network, trusted peer(s) for Nebu, LB hops nginx resolves itself.
    compose_subnet      = var.compose_subnet
    compose_gateway     = local.compose_gateway
    compose_ip_range    = local.compose_ip_range
    compose_proxy_ip    = local.compose_proxy_ip
    trusted_proxy_cidrs = local.trusted_proxy_cidrs
    lb_real_ip_cidrs    = var.lb_real_ip_cidrs
    # Logging — UpCloud has no managed Loki equivalent. Fluent Bit shipping is disabled.
    # To forward logs externally, install and configure Fluent Bit manually on the VM.
    pii_encryption_key = var.pii_encryption_key
    enable_logs        = false
    logs_ingest_host   = ""
    logs_bearer_token  = ""
    environment        = var.environment
    # Container resource limits
    server_cpu_limit     = var.server_cpu_limit
    server_memory_limit  = var.server_memory_limit
    dex_cpu_limit        = var.dex_cpu_limit
    dex_memory_limit     = var.dex_memory_limit
    element_cpu_limit    = var.element_cpu_limit
    element_memory_limit = var.element_memory_limit
    clamav_cpu_limit     = var.clamav_cpu_limit
    clamav_memory_limit  = var.clamav_memory_limit
    # Element Web
    enable_element_web = var.enable_element_web
    # Media object storage — UpCloud Managed Object Storage (S3-compatible).
    # Credentials are generated by OpenTofu; no manual portal step required.
    # ADR-024: ClamAV (malware scanning) is deployed alongside the media
    # gateway — same enable_media_gateway flag, no separate toggle.
    enable_media_gateway = var.enable_media_gateway
    s3_access_key        = local.s3_access_key
    s3_secret_key        = local.s3_secret_key
    s3_endpoint          = local.s3_endpoint
    s3_iam_endpoint      = local.s3_iam_endpoint
    s3_sts_endpoint      = local.s3_sts_endpoint
    s3_bucket            = var.s3_bucket
    # UpCloud managed PostgreSQL uses Aiven's internal CA — not in the system
    # trust store. Extract the TLS cert chain at boot via the private SDN.
    fetch_postgres_ca = false
  })

  lifecycle {
    precondition {
      condition     = !var.enable_media_gateway || local.s3_endpoint != ""
      error_message = "enable_media_gateway is set, but the managed object storage service reports no endpoint (yet). Without an endpoint the server cannot store media; re-run tofu apply once the service is running."
    }

    precondition {
      condition     = var.oidc_mode != "dex" || var.dex_static_password_hash != null
      error_message = "dex_static_password_hash is required when oidc_mode = 'dex'."
    }

    precondition {
      condition     = var.oidc_mode != "dex" || (var.oidc_client_id != null && var.oidc_client_secret != null)
      error_message = "oidc_client_id and oidc_client_secret are required when oidc_mode = 'dex'."
    }

    precondition {
      condition     = !var.enable_element_web || var.tls_mode != "none"
      error_message = "enable_element_web requires tls_mode = 'acme', 'dynamic', or 'alb'. Without a reverse proxy, Element Web runs on port 7070 while server is on port 8008 — different origins cause CORS preflight failures."
    }

    precondition {
      condition     = var.tls_mode != "dynamic" || var.acme_email != ""
      error_message = "acme_email is required when tls_mode = 'dynamic' (used for Let's Encrypt certificate registration by UpCloud)."
    }

    precondition {
      condition     = !local.compose_overlaps_network
      error_message = "compose_subnet (${var.compose_subnet}) overlaps network_cidr (${var.network_cidr}). Pick a disjoint compose_subnet (default 172.30.0.0/24): an overlap makes the VM route private-network traffic (the LB) into the docker bridge."
    }

    precondition {
      condition     = var.tls_mode != "none" || var.trusted_proxy_cidrs == ""
      error_message = "trusted_proxy_cidrs must be empty when tls_mode = 'none': port 8008 is published on all interfaces there, so trusting any proxy address would let a client claim it."
    }

    precondition {
      condition     = length(var.lb_real_ip_cidrs) == 0 || (contains(["alb", "dynamic"], var.tls_mode) && local.lb_https_frontend_mode == "http")
      error_message = "lb_real_ip_cidrs is only supported with tls_mode = 'alb' or 'dynamic': the realip listener (:8081) must only be reachable through an HTTP-mode LB frontend (set_forwarded_headers). A TCP-mode frontend cannot carry X-Forwarded-For."
    }

    precondition {
      condition     = local.lb_real_ip_cidrs_in_network
      error_message = "Every lb_real_ip_cidrs entry must lie inside network_cidr (${var.network_cidr}); list the exact LB address(es) as /32 (see output lb_private_addresses)."
    }
  }
}
