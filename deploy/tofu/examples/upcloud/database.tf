# ── UpCloud Managed PostgreSQL ─────────────────────────────────────────────────
# Provides automated daily backups, connection pooling, and high availability
# via the UpCloud platform. The service is only accessible within the private
# network (public_access = false).
#
# Verify available plans: upctl database plans --type postgresql

resource "upcloud_managed_database_postgresql" "nebu" {
  name  = "nebu-${var.environment}"
  plan  = var.db_plan
  zone  = var.zone
  title = "Nebu PostgreSQL (${var.environment})"

  properties {
    version       = "18"
    public_access = false
  }
  #  additional_disk_space_gib = 20

  network {
    family = "IPv4"
    name   = upcloud_network.nebu.name
    type   = "private"
    uuid   = upcloud_network.nebu.id
  }
}

resource "upcloud_managed_database_user" "nebu_app" {
  service  = upcloud_managed_database_postgresql.nebu.id
  username = "nebu_app"
  # Password is auto-generated by UpCloud and stored in Terraform state.
}

# nebu_migrate: DDL user — owns tables/sequences and runs migrations.
# NEBU_DB_URL_MIGRATE in .env points to this user.
resource "upcloud_managed_database_user" "nebu_migrate" {
  service  = upcloud_managed_database_postgresql.nebu.id
  username = "nebu_migrate"
  # Password is auto-generated by UpCloud and stored in Terraform state.
}

resource "upcloud_managed_database_logical_database" "nebu" {
  service = upcloud_managed_database_postgresql.nebu.id
  name    = "nebu"
}
