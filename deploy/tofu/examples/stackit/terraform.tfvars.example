# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in the values.
# Do NOT commit terraform.tfvars — it contains secrets.
#
# Quick-start:
#   cp terraform.tfvars.example terraform.tfvars
#   # fill in the REQUIRED values below
#   tofu init && tofu apply

# ── STACKIT Project ───────────────────────────────────────────────────────────

# Required: your STACKIT project UUID (visible in the STACKIT portal)
stackit_project_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Required: path to your STACKIT service account key JSON file
# Download from: STACKIT portal → IAM → Service Accounts → Keys → Create Key (JSON)
# Keep this file out of version control.
stackit_key_path = "/path/to/stackit-sa-key.json"

# Required: contents of your SSH public key (e.g. ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAA... operator@example.com"

# Required: Ubuntu 24.04 LTS image ID for your STACKIT region.
# Look up the current ID: STACKIT portal → Compute → Images → Ubuntu 24.04 LTS
ubuntu_image_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ── VM & Region ───────────────────────────────────────────────────────────────

# Optional: deployment environment label (used in resource names)
environment = "dev"

# Optional: STACKIT region
region = "eu01"

# Optional: availability zone within the region
availability_zone = "eu01-1"

# Optional: network CIDR block
network_cidr = "10.0.0.0/24"

# Optional: VM machine type (run `stackit compute server machine-types list`)
# g2i.2 = 4 vCPU / 8 GB RAM — sufficient for a small production deployment
vm_plan_id = "g2i.2"

# ── TLS mode ──────────────────────────────────────────────────────────────────
# "none": no TLS, gateway exposed on port 8008 via NLB TCP passthrough.
# "acme": nginx on VM + certbot Let's Encrypt (HTTP-01 challenge on first boot).
#         Requires dns_mode = "default". Use acme_staging = true to avoid rate limits.
# "alb":  Stackit Application Load Balancer terminates TLS — no nginx on the VM.
#         Provide the certificate + private key below (obtain externally, e.g. via
#         certbot DNS-01 challenge against your domain hoster).

tls_mode     = "alb"            # or: "acme", "none"
acme_email   = "ops@example.com"
acme_staging = true             # only relevant when tls_mode = "acme"

# Required when tls_mode = "alb": PEM certificate (fullchain) and private key.
# Example (after obtaining via certbot):
#   tls_certificate_pem = file("/etc/letsencrypt/live/chat.example.com/fullchain.pem")
#   tls_private_key_pem = file("/etc/letsencrypt/live/chat.example.com/privkey.pem")
tls_certificate_pem = "<REPLACE: PEM certificate fullchain>"
tls_private_key_pem = "<REPLACE: PEM private key>"

# ── PostgresFlex managed database ────────────────────────────────────────────

# Optional: number of PostgresFlex replicas (1 = dev/testing, 3 = production HA)
postgres_replicas = 1

# Optional: CPU cores for the PostgresFlex instance flavor
postgres_cpu = 2

# Optional: RAM in GB for the PostgresFlex instance flavor
postgres_ram = 4

# Optional: storage size in GB
# Production recommendation: start with 50 GB and enable autoscaling via the portal.
postgres_storage_size = 20

# ── Secrets & Encryption ─────────────────────────────────────────────────────

# Required: shared PSK for gateway ↔ core node registration (ADR-008).
# Generate with: openssl rand -hex 32
internal_secret = "<REPLACE: openssl rand -hex 32>"

# Required: 32-byte AES key for PII field encryption in the Elixir core.
# Generate with: openssl rand -hex 32
pii_encryption_key = "<REPLACE: openssl rand -hex 32>"

# Required: 32-byte master key for encrypting compliance signing keys at rest.
# Generate with: openssl rand -hex 32
# IMPORTANT: keep this value — losing it makes stored compliance keys unrecoverable.
key_encryption_key = "<REPLACE: openssl rand -hex 32>"

# Optional: runtime environment name. Controls KEK enforcement.
# Non-dev/staging values require key_encryption_key to be set.
nebu_env = "production"

# ── OIDC Profile ─────────────────────────────────────────────────────────────
# Choose 'dex' to deploy a bundled Dex IdP sidecar (test/demo environments).
# Choose 'external' to use an external OIDC provider (production).
#
# WARNING (dex mode): Dex runs on plain HTTP (port 5556) unless tls_mode != "none".
# Use dex mode ONLY in isolated test/demo environments — NEVER for production.
oidc_mode = "external"  # or: "dex"

# Required only when oidc_mode = "external".
oidc_issuer = "https://auth.example.com/realms/nebu"

# Required: OIDC client secret.
# dex mode:      embedded into Dex staticClients (same value used by gateway and Dex)
# external mode: must match the client secret registered in your OIDC provider
oidc_client_id = "<REPLACE_WITH_OIDC_CLIENT_SECRET>"

# Required: OIDC client secret.
# dex mode:      embedded into Dex staticClients (same value used by gateway and Dex)
# external mode: must match the client secret registered in your OIDC provider
oidc_client_secret = "<REPLACE_WITH_OIDC_CLIENT_SECRET>"

# ── Dex static users (oidc_mode = "dex" only) ────────────────────────────────
# Generate hashes with: htpasswd -bnBC 12 '' 'yourpassword' | tr -d ':' | sed 's/$2y/$2a/'
# Tip: $2y$ output from htpasswd is also accepted directly (no sed needed).

# Required when oidc_mode = "dex": operator account (group: instance_admin)
dex_static_password_hash = "<REPLACE_WITH_BCRYPT_HASH>"

# Optional: additional demo/test users — comment out to skip provisioning
# dex_user1_password_hash      = "<REPLACE_WITH_BCRYPT_HASH>"   # alice@example.com (group: users)
# dex_user2_password_hash      = "<REPLACE_WITH_BCRYPT_HASH>"   # bob@example.com   (group: users)
# dex_compliance_password_hash = "<REPLACE_WITH_BCRYPT_HASH>"   # compliance@example.com (group: compliance_officer)

# Optional: CIDR allowed to reach Dex on port 5556 (dex mode, tls_mode = "none" only).
# Restrict to your IP or VPN CIDR — default 0.0.0.0/0 is only safe for isolated envs.
# dex_allowed_cidr = "0.0.0.0/0"

# ── Domain & Registry ────────────────────────────────────────────────────────

# Required: public domain name of the Nebu instance (used as NEBU_SERVER_NAME)
server_name = "chat.example.com"

# Required: container image registry prefix.
# Images are pushed as:
#   <image_registry>/nebu-gateway:<nebu_version>
#   <image_registry>/nebu-core:<nebu_version>
image_registry = "registry.gitlab.com/myorg/nebu-server"

# Required: SemVer tag without the 'v' prefix (e.g. "0.2.1" for Git tag v0.2.1).
# Never use "latest" — the module validates this and will reject it.
nebu_version = "0.2.1"

# ── DNS ──────────────────────────────────────────────────────────────────────
# dns_mode = "default": creates a Stackit DNS zone + A-record (server_name → floating IP).
#   Requires the Stackit DNS service to be enabled in your project.
#   If the DNS zone already exists, import it first:
#     tofu import stackit_dns_zone.nebu <zone_id>
# dns_mode = "external": skips DNS creation — register the 'dns_name' output as an
#   A-record in your own DNS provider.
dns_mode = "external"  # or: "default" (required for tls_mode = "acme" HTTP-01 challenge)

# When dns_mode = "default": optionally create a dex.<server_name> A-record.
# Only useful when oidc_mode = "dex" and using host-based routing for Dex.
# dex_subdomain_enabled = false

# Contact email for the Stackit DNS zone (optional, recommended for production).
# dns_contact_email = ""

# ── Element Web client ────────────────────────────────────────────────────────
# Requires tls_mode = "acme" (lifecycle precondition enforced by tofu apply).
# Without nginx, Element (port 7070) and gateway (port 8008) are different origins
# and all Matrix API requests from Element fail with CORS preflight errors.
# enable_element_web = false

# ── Logging (Stackit Logs / Loki) ────────────────────────────────────────────
# When enable_logs = true, creates a Stackit Logs instance and ships nebu.service
# journal logs via Fluent Bit from first boot.
# enable_logs = false
# logs_retention_days = 30

# ── Container resource limits ─────────────────────────────────────────────────
# Default values are tuned for a g2i.2 VM (4 vCPU / 8 GB RAM).
# Adjust if using a larger or smaller VM type.
# Total defaults: 2.50 vCPU + 2.5 GB (leaves ~1.5 vCPU + 5.5 GB for OS and headroom)
#
# gateway_cpu_limit    = "0.50"   # Go gateway — lean on CPU and memory
# gateway_memory_limit = "256m"
# core_cpu_limit       = "1.50"   # Elixir/BEAM — benefits from multiple cores
# core_memory_limit    = "2g"     # BEAM allocates aggressively — set this to prevent OOM
# dex_cpu_limit        = "0.25"   # Dex IdP sidecar (oidc_mode = "dex" only)
# dex_memory_limit     = "128m"
# element_cpu_limit    = "0.25"   # Element Web (enable_element_web = true only)
# element_memory_limit = "128m"
