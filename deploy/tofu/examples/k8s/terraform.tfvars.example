# Copy this file to terraform.tfvars and fill in the values.
# Do NOT commit terraform.tfvars — it may contain sensitive paths.

# kubeconfig_path = "~/.kube/config"   # default: ~/.kube/config
# kube_context    = "kind-nebu-dev"     # leave empty to use the active context

# Image tag for server.
# go-removal-cleanup: server is now the single application image (serves public
# Matrix + media + admin). There is no separate gateway/media image.
# For local kind dev workflows: keep "dev" (matches what `make build-server` produces).
# For release builds: use the SemVer tag without the 'v' prefix (e.g. "1.0.0" for
# Git tag v1.0.0), produced by the CI release pipeline (release-server-image job).
server_image_tag = "dev"

# namespace   = "nebu"                   # default: nebu
# chart_path  = "../../../helm/nebu"     # default: relative path to the Helm chart
# ingress_enabled = false                # default: false

# domain_name      = "chat.example.com"  # used by nebu-shared shared module
# admin_email      = "admin@example.com"
# postgres_db_name = "nebu"
# image_registry   = "registry.gitlab.com/philippb/open-chat"
